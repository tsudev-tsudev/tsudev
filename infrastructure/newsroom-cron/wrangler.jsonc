{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tsudev-newsroom-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // MỘT nhịp duy nhất: giữ ấm Render. KHÔNG chạm database.
  //
  // 🔴 NHỊP THỨ HAI ĐÃ BỊ GỠ 29/10/2026, và đừng dựng lại.
  //
  // Nhịp đó là `"7 0-17,23 * * *"` - nhịp đập của Toà soạn Agent AI, gọi
  // `POST /api/newsroom/tick` và CÓ truy vấn database. Chủ dự án chốt bỏ hoàn
  // toàn cơ chế Toà soạn và việc tự động đăng bài, để tiết kiệm token/hạn mức/
  // cửa sổ ngữ cảnh của Agent AI (kế hoạch: docs/refactor-tsudev-2026-q4.md §8).
  //
  // Hệ quả KỸ THUẬT, không chỉ là bớt một việc: nhịp giờ đó là **nguồn đánh thức
  // Neon theo LỊCH duy nhất** của cả hệ thống. Gỡ nó, cộng với bản vá vòng poll
  // 3 giây của `/admin/newsroom` (đã phát hành 29/10), thì không còn gì đánh
  // thức database theo lịch nữa - database chỉ còn thức khi có người thật dùng
  // trang quản trị. Đó là đòn trực tiếp vào hạn mức 100 CU-giờ/tháng của Neon,
  // thứ đã treo compute và làm cả site trống suốt hai tháng.
  //
  // ⚠️ `GET /health` của backend-bundle trả JSON TĨNH, không đụng Prisma - nên
  // nhịp 5 phút này KHÔNG đánh thức Neon. Đừng đổi nó sang một endpoint chạm
  // database "cho chắc là backend còn sống": làm vậy là tự tay dựng lại đúng cái
  // bẫy vừa gỡ, chỉ ở dạng dày hơn 12 lần.
  //
  // (Không viết chuỗi cron 5 phút vào chú thích khối: nó chứa dấu đóng comment
  // và sẽ cắt cụt khối này - đã trả giá một lần.)
  //
  // ⚠️ `0-17,23` LÀ GIỜ UTC, và đó là khung NGHỈ 01:00-06:00 giờ Việt Nam
  // (UTC+7) viết ngược lại. Cron của Cloudflare không có múi giờ - đọc nhầm nó
  // thành giờ VN là đặt khung nghỉ vào đúng giờ cao điểm.
  //
  // Vì sao có khung nghỉ: giữ ấm 24/7 tiêu 744 trên 750 giờ instance/tháng của
  // Render trong tháng 31 ngày, mà hạn mức đó tính cho CẢ workspace - biên 6 giờ
  // nghĩa là thêm bất kỳ service free thứ hai nào cũng làm Render tạm dừng MỌI
  // service. Nghỉ 5 giờ mỗi đêm hạ xuống ~589 giờ, biên ~161 giờ. Cái giá đã
  // được chủ dự án chốt: người truy cập đầu tiên sau khung nghỉ chờ cold start
  // ~50 giây.
  //
  // 🟢 VIỆC SẮP TỚI của Worker này: cắm `prod:dem-noi-dung` vào đây
  // (kế hoạch §6.1). Nó là chỗ ĐÚNG vì Worker này miễn phí, có lịch, và KHÔNG có
  // kết nối Postgres - tức nó vẫn trả lời được đúng lúc database chết, tức đúng
  // lúc cần nhất. Đừng xoá thư mục này khi gỡ Toà soạn.
  "triggers": {
    "crons": ["*/5 0-17,23 * * *"]
  },

  // KHÔNG có route/custom_domain: Worker này không phục vụ người dùng. Nó vẫn
  // có URL workers.dev để gõ tay lúc nghiệm thu, và đường đó đã được gác token.
  "workers_dev": true,

  // BACKEND_URL không bí mật nên để ở đây. NEWSROOM_TICK_TOKEN là BÍ MẬT -
  // đặt bằng `npm run cron:secret`, ĐỪNG commit vào tệp này.
  "vars": {
    "BACKEND_URL": "https://tsudev-backend.onrender.com"
  },

  "observability": {
    "enabled": true
  }
}
