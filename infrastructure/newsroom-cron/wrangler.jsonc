{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tsudev-newsroom-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // HAI nhịp, hai việc khác nhau - src/index.ts phân nhánh theo `event.cron`:
  //
  //   "*/5 * * * *"  giữ ấm Render (GET /health, KHÔNG chạm database).
  //                  Render free ngủ sau ~15 phút không có request; thưa hơn
  //                  15 phút là mất việc này.
  //   "7 * * * *"    nhịp đập của toà soạn (POST /api/newsroom/tick, CÓ truy
  //                  vấn database). Mỗi giờ, không dày hơn: truy vấn mỗi 5
  //                  phút thì Neon free không bao giờ tự ngủ và tiêu ~186
  //                  CU-giờ/tháng trên hạn mức 100 ⇒ treo compute cả site.
  //                  Chuỗi này phải TRÙNG NGUYÊN VĂN `TICK_CRON` trong mã.
  //                  Phút 7 chứ không phải 0 để không trùng lượt giữ ấm - hai
  //                  lượt cùng lúc không sai, chỉ khó đọc log.
  //
  // Cron Triggers nằm trong gói Workers Free và KHÔNG tính phí riêng; chúng ăn
  // chung hạn mức 100.000 request/ngày. 288 + 24 lượt/ngày là muối bỏ bể.
  "triggers": {
    "crons": ["*/5 * * * *", "7 * * * *"]
  },

  // KHÔNG có route/custom_domain: Worker này không phục vụ người dùng. Nó vẫn
  // có URL workers.dev để gõ tay lúc nghiệm thu, và đường đó đã được gác token.
  "workers_dev": true,

  // BACKEND_URL không bí mật nên để ở đây. NEWSROOM_TICK_TOKEN là BÍ MẬT -
  // đặt bằng `npm run cron:secret`, ĐỪNG commit vào tệp này.
  "vars": {
    "BACKEND_URL": "https://tsudev-backend.onrender.com"
  },

  "observability": {
    "enabled": true
  }
}
