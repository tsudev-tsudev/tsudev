{
  // KHÔNG kế thừa tsconfig.base.json và KHÔNG nằm trong `references` của
  // tsconfig gốc: Worker chạy trên runtime của Cloudflare, không phải Node.
  // Trộn hai bộ kiểu (@cloudflare/workers-types và @types/node) làm cả hai sai.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "webworker"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
