diff --git a/apps/frontend-main/pages/api/auth/[...nextauth].js b/apps/frontend-main/pages/api/auth/[...nextauth].js
new file mode 100644
index 0000000..be6f6e3
--- /dev/null
+++ b/apps/frontend-main/pages/api/auth/[...nextauth].js
@@ -0,0 +1,39 @@
+require('dotenv').config()
+import NextAuth from 'next-auth'
+import KeycloakProvider from 'next-auth/providers/keycloak'
+import CredentialsProvider from 'next-auth/providers/credentials'
+
+const providers = []
+
+// Add a test-only credentials provider when running E2E in CI/docker.
+if (process.env.E2E_BYPASS_KEYCLOAK === '1') {
+  providers.push(CredentialsProvider({
+    id: 'e2e-dev',
+    name: 'E2E-Dev',
+    credentials: {
+      username: { label: 'Username', type: 'text' },
+      password: { label: 'Password', type: 'password' }
+    },
+    async authorize(credentials) {
+      if (!credentials) return null
+      const user = { id: credentials.username, name: credentials.username, email: `${credentials.username}@example.local` }
+      const okUser = process.env.E2E_USER || 'devuser'
+      const okPass = process.env.E2E_PASS || 'devpass'
+      if (credentials.username === okUser && credentials.password === okPass) return user
+      return null
+    }
+  }))
+}
+
+// Always include Keycloak provider (so dev UI still shows it)
+providers.push(KeycloakProvider({
+  clientId: process.env.KEYCLOAK_CLIENT_ID,
+  clientSecret: process.env.KEYCLOAK_CLIENT_SECRET,
+  issuer: process.env.KEYCLOAK_ISSUER
+}))
+
+export default NextAuth({
+  providers,
+  secret: process.env.NEXTAUTH_SECRET,
+  session: { strategy: 'jwt' }
+})
diff --git a/apps/frontend-main/pages/index.js b/apps/frontend-main/pages/index.js
new file mode 100644
index 0000000..e1aaec3
--- /dev/null
+++ b/apps/frontend-main/pages/index.js
@@ -0,0 +1,84 @@
+import React from 'react'
+import { useSession, signIn, signOut } from 'next-auth/react'
+import { Layout } from '@tsudev/ui'
+
+export default function Home() {
+  const { data: session } = useSession()
+  return (
+    <Layout>
+      <div className="p-6">
+        <h1 className="text-2xl font-semibold">tsudev — Main Site (Scaffold)</h1>
+        <p className="mt-2">This is a placeholder Next.js app for the tsudev main site.</p>
+        <p id="hotreload-marker" className="mt-2 text-sm text-gray-600">HOT-RELOAD-MARKER: updated by assistant</p>
+        <div className="mt-4">
+          {session ? (
+            <>
+              <div>Signed in as {session.user?.email || session.user?.name}</div>
+              <button className="mt-2 px-3 py-1 bg-red-500 text-white rounded" onClick={() => signOut()}>Sign out</button>
+            </>
+          ) : (
+            <>
+              <div>Not signed in</div>
+              <button className="mt-2 px-3 py-1 bg-blue-500 text-white rounded" onClick={() => signIn()}>Sign in</button>
+            </>
+          )}
+        </div>
+        <div className="mt-6">
+          <h3 className="font-medium">Upload a file</h3>
+          <input id="file-input" className="mt-2" type="file" />
+          <div className="mt-2">
+            <button className="px-3 py-1 bg-green-600 text-white rounded" onClick={async () => {
+              const el = document.getElementById('file-input')
+              if (!el || !el.files || el.files.length === 0) { alert('Choose a file'); return }
+              const f = el.files[0]
+              const storageBase = process.env.NEXT_PUBLIC_STORAGE_URL || 'http://localhost:4002'
+              try {
+                const resp = await fetch(`${storageBase}/api/presign`, {
+                  method: 'POST',
+                  headers: { 'Content-Type': 'application/json' },
+                  body: JSON.stringify({ fileName: f.name, contentType: f.type })
+                })
+                const json = await resp.json()
+                if (!json.url) throw new Error(json.error || 'No url')
+                // Try direct upload to presigned URL
+                let putOk = false
+                try {
+                  const putResp = await fetch(json.url, { method: 'PUT', body: f, headers: { 'Content-Type': f.type || 'application/octet-stream' } })
+                  if (putResp.ok) { putOk = true }
+                } catch (putErr) {
+                  console.warn('Direct PUT failed, will try server-side upload', putErr)
+                }
+                if (!putOk) {
+                  // Fallback: upload to storage-service which will proxy to S3
+                  try {
+                    const uploadResp = await fetch(`${storageBase}/api/upload?key=${encodeURIComponent(json.key)}`, {
+                      method: 'POST',
+                      headers: { 'Content-Type': f.type || 'application/octet-stream', 'X-Filename': f.name },
+                      body: await f.arrayBuffer()
+                    })
+                    const uploadJson = await uploadResp.json()
+                    if (!uploadResp.ok) throw new Error(uploadJson.error || 'upload failed')
+                    alert('Upload (server-side) complete: ' + uploadJson.key)
+                    return
+                  } catch (srvErr) {
+                    console.error('Server-side upload failed', srvErr)
+                    alert('Upload failed: ' + (srvErr.message || srvErr))
+                    return
+                  }
+                }
+                alert('Upload complete: ' + json.key)
+              } catch (err) {
+                console.error(err)
+                alert('Upload failed: ' + (err.message || err))
+              }
+            }}>Upload</button>
+          </div>
+        </div>
+        <ul className="mt-4">
+          <li><a className="text-blue-600 underline" href="/">Home</a></li>
+          <li><a className="text-blue-600 underline" href="http://localhost:3001">Forum</a></li>
+        </ul>
+      </div>
+    </Layout>
+  )
+}
