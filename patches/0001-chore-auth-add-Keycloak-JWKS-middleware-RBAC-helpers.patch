new file mode 100644
index 0000000..b1e4dbe
--- /dev/null
+++ b/apps/sso-auth/keycloak/realm-export.json
@@ -0,0 +1,40 @@
+{
+  "realm": "tsudev-local",
+  "enabled": true,
