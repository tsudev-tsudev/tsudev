+++ b/services/api-gateway/src/index.js
@@ -0,0 +1,70 @@
+require('source-map-support').install()
+require('dotenv').config()
+const express = require('express')
+const { createProxyMiddleware } = require('http-proxy-middleware')
+
+const app = express()
+const port = process.env.PORT || process.env.PORT_API_GATEWAY || 8080
+
+const USER_SERVICE = process.env.USER_SERVICE_URL || 'http://localhost:4000'
+const CONTENT_SERVICE = process.env.CONTENT_SERVICE_URL || 'http://localhost:4001'
+const STORAGE_SERVICE = process.env.STORAGE_SERVICE_URL || 'http://localhost:4002'
+
+// Basic logging
+app.use((req, res, next) => { try { console.log(`[gateway] ${req.method} ${req.url}`) } catch (e) {} ; next() })
+
+// Auth middleware - verify tokens before proxying to internal APIs
+let auth
+try {
+  auth = require('./authMiddleware')
+} catch (e) {
+  auth = (req, res, next) => next()
+}
+
+// Proxy rules
+app.use('/api/users', auth, createProxyMiddleware({ target: USER_SERVICE, changeOrigin: true }))
+app.use('/api/posts', auth, createProxyMiddleware({ target: CONTENT_SERVICE, changeOrigin: true }))
+app.use('/api/files', auth, createProxyMiddleware({ target: STORAGE_SERVICE, changeOrigin: true }))
+app.use('/api/presign', auth, createProxyMiddleware({ target: STORAGE_SERVICE, changeOrigin: true }))
+app.use('/api/upload', auth, createProxyMiddleware({ target: STORAGE_SERVICE, changeOrigin: true }))
+
+app.get('/health', (req, res) => res.json({ status: 'ok', service: 'api-gateway' }))
+
+app.listen(port, () => console.log(`api-gateway listening on ${port}`))
+
+module.exports = { app }
