+const request = require('supertest')
+const { app } = require('../src/index')
+
+describe('storage-service auth enforcement', () => {
+  test('GET /api/presign returns 401 without Authorization', async () => {
+    const res = await request(app).get('/api/presign').query({ fileName: 'foo.txt' })
+    expect(res.status).toBe(401)
+  })
+
+  test('POST /api/presign returns 401 without Authorization', async () => {
+    const res = await request(app).post('/api/presign').send({ fileName: 'foo.txt' })
+    expect(res.status).toBe(401)
+  })
+
+  test('POST /api/upload returns 401 without Authorization', async () => {
+    const res = await request(app)
+      .post('/api/upload')
+      .set('Content-Type', 'application/octet-stream')
+      .send(Buffer.from('hello'))
+    expect(res.status).toBe(401)
+  })
+})
