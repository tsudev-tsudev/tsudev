+    } catch (e) {}
+    try { await dumpDebug(page, 'provider-before-rewrite') } catch(_) {}
+      try {
+        // Try clicking the provider button directly so the browser performs the
+        // POST/redirects (Chromium has host-resolver-rules to map container
