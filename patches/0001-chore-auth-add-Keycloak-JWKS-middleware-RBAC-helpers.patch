+++ b/docker-compose.yml
@@ -0,0 +1,128 @@
+services:
+  keycloak:
+    image: quay.io/keycloak/keycloak:21.1.1
+    command: start-dev
+    environment:
+      - KEYCLOAK_ADMIN=${KEYCLOAK_ADMIN}
+      - KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}
+      - KEYCLOAK_IMPORT=/opt/keycloak/data/import/realm-export.json
+    ports:
+      - "8080:8080"
+    volumes:
+      - ./apps/sso-auth/keycloak/realm-export.json:/opt/keycloak/data/import/realm-export.json:ro
+
+  postgres:
+    image: postgres:15-alpine
+    environment:
+      - POSTGRES_USER=${POSTGRES_USER}
+      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
+      - POSTGRES_DB=${POSTGRES_DB}
+    volumes:
+      - postgres_data:/var/lib/postgresql/data
+    ports:
+      - "5432:5432"
+
+  redis:
+    image: redis:7-alpine
+    command: ["redis-server","--requirepass","${REDIS_PASSWORD}" ]
+    ports:
+      - "6379:6379"
+
+  minio:
+    image: minio/minio:latest
+    command: server /data
+    environment:
+      - MINIO_ROOT_USER=${MINIO_ROOT_USER}
+      - MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
+    ports:
+      - "9000:9000"
+    volumes:
+      - minio_data:/data
+
+  user-service:
+    build: ./services/user-service
+    ports:
+      - "4000:4000"
+    depends_on:
+      - postgres
+      - redis
+
+  content-service:
+    build: ./services/content-service
+    ports:
+      - "4001:4001"
+    depends_on:
+      - postgres
+
+  frontend-main:
+    build:
+      context: .
+      dockerfile: apps/frontend-main/Dockerfile
+    ports:
+      - "3000:3000"
+    depends_on:
+      - user-service
+      - content-service
+    environment:
+      - NEXTAUTH_URL=http://frontend-main:3000
+      - NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
+      - E2E_BYPASS_KEYCLOAK=1
+      - KEYCLOAK_ISSUER=http://keycloak:8080/realms/tsudev-local
+      - KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID}
+      - KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}
+      - NEXT_PUBLIC_STORAGE_URL=http://storage-service:4002
+
+  frontend-forum:
+    build:
+      context: .
+      dockerfile: apps/frontend-forum/Dockerfile
+    ports:
+      - "3001:3001"
+    depends_on:
+      - user-service
+    environment:
+      - NEXTAUTH_URL=http://frontend-forum:3001
+      - NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
+      - KEYCLOAK_ISSUER=http://keycloak:8080/realms/tsudev-local
+      - KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID}
+      - KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}
+      - NEXT_PUBLIC_STORAGE_URL=http://storage-service:4002
+
+  storage-service:
+    build: ./services/storage-service
+    ports:
+      - "4002:4002"
+    depends_on:
+      - minio
+    environment:
+      - S3_ENDPOINT=http://minio:9000
+      - S3_PUBLIC_ENDPOINT=http://minio:9000
+      - S3_BUCKET=tsudev
+      - S3_ACCESS_KEY=${MINIO_ROOT_USER}
+      - S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
+    # Mount only the src directory so we can iterate on runtime code
+    # without rebuilding the image and without masking node_modules.
+    volumes:
+      - ./services/storage-service/src:/usr/src/app/src:cached
+
+  e2e-runner:
+    build:
+      context: .
+      dockerfile: docker/e2e-runner.Dockerfile
+    working_dir: /work
+    volumes:
+      - ./:/work:cached
+    environment:
+      - E2E_FRONTEND=http://frontend-main:3000
+      - E2E_STORAGE=http://storage-service:4002
+      - E2E_UPLOAD_PATH=/work/scripts/upload-file.txt
+      - E2E_IN_DOCKER=1
+    depends_on:
+      - frontend-main
+      - keycloak
+      - storage-service
+    command: ["bash", "-lc", "for i in $(seq 1 60); do if (echo > /dev/tcp/frontend-main/3000) >/dev/null 2>&1; then echo 'frontend up'; break; fi; echo 'waiting for frontend-main...'; sleep 1; done; node /work/scripts/e2e-sso-upload.js"]
+
+volumes:
+  postgres_data:
+  minio_data:
