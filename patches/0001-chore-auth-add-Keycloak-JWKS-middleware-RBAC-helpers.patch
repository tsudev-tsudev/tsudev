index 0000000..ec7e1fc
--- /dev/null
+++ b/apps/frontend-forum/pages/api/auth/[...nextauth].js
@@ -0,0 +1,15 @@
+require('dotenv').config()
+import NextAuth from 'next-auth'
+import KeycloakProvider from 'next-auth/providers/keycloak'
+
+export default NextAuth({
+  providers: [
+    KeycloakProvider({
+      clientId: process.env.KEYCLOAK_CLIENT_ID,
+      clientSecret: process.env.KEYCLOAK_CLIENT_SECRET,
+      issuer: process.env.KEYCLOAK_ISSUER
+    })
+  ],
+  secret: process.env.NEXTAUTH_SECRET,
+  session: { strategy: 'jwt' }
+})
diff --git a/apps/frontend-forum/pages/index.js b/apps/frontend-forum/pages/index.js
new file mode 100644
index 0000000..cbfcd2a
--- /dev/null
+++ b/apps/frontend-forum/pages/index.js
@@ -0,0 +1,29 @@
+import React from 'react'
+import { useSession, signIn, signOut } from 'next-auth/react'
+import { Layout } from '@tsudev/ui'
+
+export default function Forum() {
+  const { data: session } = useSession()
+  return (
+    <Layout>
+      <div className="p-6">
+        <h1 className="text-2xl font-semibold">tsudev — Forum (Scaffold)</h1>
+        <p className="mt-2">This is a placeholder forum frontend.</p>
+        <p className="mt-2">The forum will later integrate with SSO and a content-service backend.</p>
+        <div className="mt-4">
+          {session ? (
+            <>
+              <div>Signed in as {session.user?.email || session.user?.name}</div>
+              <button className="mt-2 px-3 py-1 bg-red-500 text-white rounded" onClick={() => signOut()}>Sign out</button>
+            </>
+          ) : (
+            <>
+              <div>Not signed in</div>
+              <button className="mt-2 px-3 py-1 bg-blue-500 text-white rounded" onClick={() => signIn()}>Sign in</button>
+            </>
+          )}
+        </div>
+      </div>
+    </Layout>
+  )
+}
