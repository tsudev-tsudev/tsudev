// tsudev — Prisma schema
// Nền tảng dữ liệu chung cho toàn hệ thống (users, blog, docs, files, con dấu).
// Provider: PostgreSQL. Local dev chạy trên cluster user-space (port 5433).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  MEMBER
  VIP
  MODERATOR
  ADMIN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  keycloakId  String?  @unique
  username    String   @unique
  email       String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  role        Role     @default(MEMBER)
  /// Đơn vị thu phí khi nộp đơn xin cấp dấu — trust-service trừ trong cùng
  /// transaction với việc đổi trạng thái đơn. KHÔNG phải tiền tệ của chợ cũ.
  credits     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]
  files FileObject[]
}

// ---------------------------------------------------------------------------
// Content: Blog & Docs
// ---------------------------------------------------------------------------
model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  contentMd String
  tags      String[] @default([])
  published Boolean  @default(true)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

model Doc {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  contentMd String
  category  String   @default("general")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, position])
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------
model FileObject {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  contentType String
  size        Int      @default(0)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Trust Seal — Nhà cung cấp Con dấu tín nhiệm
//
// Vòng đời: tổ chức đăng ký -> xác minh sở hữu domain -> nộp đơn theo chương
// trình -> kiểm tra tự động + admin duyệt -> cấp chứng chỉ (có serial, hạn,
// chữ ký Ed25519) -> tái kiểm định kỳ -> gia hạn / treo / thu hồi.
//
// Chương trình dấu để trong BẢNG chứ không phải enum: thêm loại dấu mới chỉ là
// thêm một dòng dữ liệu, không cần migration.
// ---------------------------------------------------------------------------

enum TrustOrgStatus {
  ACTIVE
  SUSPENDED
}

enum DomainVerifyMethod {
  DNS_TXT
  META_TAG
  FILE
}

enum DomainVerifyStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum SealApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CertificateStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

/// Cơ sở đánh giá — in trên trang xác thực để người đọc biết con dấu dựa vào
/// đâu. Cấp dấu pháp lý mà chỉ SELF_DECLARED là rủi ro, nên admin phải chọn.
enum AssessmentBasis {
  SELF_DECLARED
  EVIDENCE_REVIEWED
  AUDITED
}

/// Tổ chức/khách hàng đứng tên xin cấp dấu. Gắn với một tài khoản tsudev.
model TrustOrganization {
  id           String         @id @default(cuid())
  ownerUserId  String
  ownerName    String
  name         String
  legalName    String?
  country      String?
  contactEmail String
  websiteUrl   String?
  status       TrustOrgStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  domains      TrustDomain[]
  applications SealApplication[]
  certificates TrustCertificate[]

  @@index([ownerUserId])
}

/// Một hostname thuộc tổ chức. Chỉ domain đã VERIFIED mới được nộp đơn.
model TrustDomain {
  id            String             @id @default(cuid())
  orgId         String
  org           TrustOrganization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hostname      String             @unique
  method        DomainVerifyMethod @default(DNS_TXT)
  /// Token ngẫu nhiên khách phải đặt vào DNS/meta/file để chứng minh quyền kiểm soát.
  token         String
  status        DomainVerifyStatus @default(PENDING)
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())

  applications SealApplication[]
  certificates TrustCertificate[]

  @@index([orgId])
  @@index([status])
}

/// Chương trình dấu (copyright-verified, ownership-attested, ...).
model SealProgram {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  summary      String
  /// Danh sách tiêu chí công khai, dạng [{ key, label, detail }].
  criteria     Json
  /// Loại bằng chứng bắt buộc, dạng [{ kind, label, required }].
  evidenceSpec Json
  validityDays Int     @default(365)
  /// Phí nộp đơn tính bằng credits (User.credits).
  feeCredits   Int     @default(0)
  /// Biến thể huy hiệu: quyết định màu/nhãn khi render SVG.
  badgeVariant String  @default("default")
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  applications SealApplication[]
  certificates TrustCertificate[]
}

/// Đơn xin cấp dấu.
model SealApplication {
  id           String                @id @default(cuid())
  orgId        String
  org          TrustOrganization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainId     String
  domain       TrustDomain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  programId    String
  program      SealProgram           @relation(fields: [programId], references: [id])
  applicantId  String
  status       SealApplicationStatus @default(DRAFT)
  /// Phạm vi khẳng định, in nguyên văn lên chứng chỉ và trang xác thực.
  scope        String?
  /// Câu trả lời của khách cho từng tiêu chí, dạng { [criteriaKey]: value }.
  answers      Json?
  feeCharged   Int                   @default(0)
  submittedAt  DateTime?
  reviewerId   String?
  reviewerName String?
  reviewNote   String?
  decidedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  evidence    SealEvidence[]
  certificate TrustCertificate?

  @@index([status, submittedAt])
  @@index([orgId])
  @@index([applicantId])
}

/// Bằng chứng khách nộp kèm đơn (link, file trong storage-service, hoặc ghi chú).
model SealEvidence {
  id            String          @id @default(cuid())
  applicationId String
  application   SealApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String
  label         String?
  url           String?
  fileObjectId  String?
  note          String?
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

/// Chứng chỉ đã cấp. `signature` là JWS Ed25519 của `payload` — bên thứ ba xác
/// minh offline được bằng khoá công khai ở /.well-known/tsudev-trust-jwks.json.
model TrustCertificate {
  id              String            @id @default(cuid())
  /// Serial người đọc được, ví dụ TSU-CR-2026-000123.
  serial          String            @unique
  applicationId   String            @unique
  application     SealApplication   @relation(fields: [applicationId], references: [id])
  orgId           String
  org             TrustOrganization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainId        String
  domain          TrustDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  programId       String
  program         SealProgram       @relation(fields: [programId], references: [id])
  status          CertificateStatus @default(ACTIVE)
  basis           AssessmentBasis   @default(EVIDENCE_REVIEWED)
  scope           String
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?
  /// Nội dung đã ký, công khai trên trang xác thực.
  payload         Json
  signature       String
  /// `kid` của khoá đã ký — cho phép xoay khoá mà chứng chỉ cũ vẫn xác minh được.
  signingKeyId    String
  issuedById      String
  issuedByName    String
  lastCheckAt     DateTime?
  lastCheckPassed Boolean?

  checks TrustCheck[]

  @@index([status, expiresAt])
  @@index([domainId])
  @@index([orgId])
}

/// Kết quả tái kiểm định kỳ (domain còn trỏ đúng, token còn đó, TLS còn hạn...).
model TrustCheck {
  id            String           @id @default(cuid())
  certificateId String
  certificate   TrustCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  ranAt         DateTime         @default(now())
  passed        Boolean
  details       Json?

  @@index([certificateId, ranAt])
}

/// Nhật ký bất biến cho mọi hành động trên hệ thống dấu — theo đúng khuôn mẫu
/// ModAction của kiểm duyệt. Cần cho trách nhiệm pháp lý khi cấp dấu.
model TrustAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Dự án & bản quyền — trọng tâm mới của website
//
// Mỗi dòng là một dự án/tool/phần mềm do tsudev phát triển. Ba nhóm trường:
// giới thiệu, phát hành, và bản quyền. Nhóm bản quyền là cầu nối sang Con dấu
// tín nhiệm: dự án có bản quyền -> website dùng dự án đó -> được cấp huy hiệu.
// ---------------------------------------------------------------------------

enum ProjectKind {
  APP
  TOOL
  LIBRARY
  SERVICE
}

enum ProjectStatus {
  WIP
  BETA
  STABLE
  ARCHIVED
}

/// NONE: chưa nộp · PENDING: đã nộp, đang chờ · REGISTERED: đã có giấy chứng nhận.
enum CopyrightStatus {
  NONE
  PENDING
  REGISTERED
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  summary       String
  descriptionMd String        @default("")
  kind          ProjectKind   @default(TOOL)
  status        ProjectStatus @default(WIP)

  // Phát hành
  version     String?
  releasedAt  DateTime?
  repoUrl     String?
  homepageUrl String?
  downloadUrl String?
  /// Mã giấy phép theo SPDX (MIT, Apache-2.0, ...). Để trống nghĩa là chưa công bố.
  license     String?

  // Bản quyền
  copyrightStatus CopyrightStatus @default(NONE)
  /// Số giấy chứng nhận đăng ký quyền tác giả. Chỉ có nghĩa khi status=REGISTERED.
  copyrightNo     String?
  copyrightAt     DateTime?
  copyrightOwner  String?

  /// Nối sang chương trình dấu tương ứng. Cố ý KHÔNG phải quan hệ khoá ngoại:
  /// dự án tồn tại độc lập, chương trình dấu có thể chưa được tạo, và xoá một
  /// chương trình không được phép kéo theo dự án.
  trustProgramSlug String?

  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([kind, status])
  @@index([copyrightStatus])
}
