// tsudev — Prisma schema
// Nền tảng dữ liệu chung cho toàn hệ thống (users, blog, docs, files, con dấu).
// Provider: PostgreSQL. Local dev chạy trên cluster user-space (port 5433).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  MEMBER
  VIP
  MODERATOR
  ADMIN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  /// Di sản của thời Keycloak. KHÔNG có dòng mã nào đọc hay ghi cột này.
  ///
  /// GIỮ LẠI CÓ CHỦ ĐÍCH cho tới khi mã mới đã lên sóng. Đợt phát hành này phải
  /// THUẦN TÍNH CỘNG: `prisma migrate deploy` chạy TRƯỚC khi service khởi động
  /// lại (nó không tự chạy lúc boot), nên trong khoảng giữa hai bước, mã CŨ vẫn
  /// đang phục vụ. Mà `GET /api/posts` dùng `include: { author: true }` ⇒ Prisma
  /// SELECT mọi cột của User, kể cả cột này. Xoá sớm là blog và trang bài viết
  /// 500 — và `lib/api.ts` nuốt lỗi thành [], nên triệu chứng là TRANG TRỐNG
  /// chứ không phải trang lỗi.
  ///
  /// Xoá ở đợt phát hành SAU, khi không còn tiến trình nào chạy schema cũ.
  keycloakId  String?  @unique
  username    String   @unique
  email       String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  role        Role     @default(MEMBER)
  /// Đơn vị thu phí khi nộp đơn xin cấp dấu — trust-service trừ trong cùng
  /// transaction với việc đổi trạng thái đơn. KHÔNG phải tiền tệ của chợ cũ.
  credits     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Xác thực do codebase tự quản lý ---
  //
  // NULL được: tài khoản chỉ đăng nhập bằng GitHub/Google hoặc chỉ bằng passkey
  // thì không có mật khẩu nào cả. Đừng suy ra "chưa đăng ký" từ cột này.
  /// Argon2id. KHÔNG BAO GIỜ trả cột này ra khỏi tầng service.
  passwordHash     String?
  /// NULL = email chưa xác minh. Đường ghi nhạy cảm phải tự kiểm, vì tài khoản
  /// vẫn tồn tại và vẫn đăng nhập được trước khi xác minh.
  emailVerifiedAt  DateTime?
  /// Thu hồi phiên mà không cần bảng phiên. JWT mang số này; đổi mật khẩu hoặc
  /// "đăng xuất mọi thiết bị" thì tăng lên, và mọi token đã phát mất hiệu lực
  /// ngay. Phiên lưu DB sẽ đúng hơn về lý thuyết nhưng frontend chạy trên
  /// Cloudflare Workers còn DB ở Neon ap-southeast-1 — nghĩa là một truy vấn
  /// xuyên lục địa cho MỖI request.
  sessionVersion   Int       @default(0)
  /// Đếm số lần sai LIÊN TIẾP; đăng nhập thành công đặt lại về 0.
  failedLoginCount Int       @default(0)
  /// Khoá tạm sau quá nhiều lần sai. Khoá theo TÀI KHOẢN, khác với chặn theo IP
  /// ở LoginAttempt — thiếu một trong hai thì kẻ tấn công chỉ cần đổi trục.
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  posts Post[]
  files FileObject[]

  oauthAccounts OAuthAccount[]
  passkeys      WebAuthnCredential[]
  totp          TotpCredential?
  backupCodes   BackupCode[]
  authTokens    AuthToken[]
}

/// Tài khoản bên thứ ba đã liên kết (GitHub, Google). Một User có thể liên kết
/// nhiều nhà cung cấp; mỗi tài khoản bên đó chỉ gắn được vào MỘT User.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "github" | "google" — chuỗi chứ không phải enum: thêm nhà cung cấp là dữ
  /// liệu, không phải migration.
  provider          String
  /// Định danh ổn định do nhà cung cấp cấp. KHÔNG dùng email làm khoá — email
  /// đổi được, và tin vào email của bên thứ ba là đường chiếm tài khoản.
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Passkey / WebAuthn.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// credentialId do trình duyệt cấp, lưu dạng base64url.
  credentialId String    @unique
  publicKey    String
  /// Bộ đếm chống phát lại: giá trị mới phải LỚN HƠN giá trị đã lưu.
  counter      Int       @default(0)
  transports   String[]  @default([])
  /// Nhãn người dùng đặt để tự phân biệt thiết bị khi thu hồi.
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Bí mật TOTP. Bảng riêng chứ không phải cột trên User: nó là bí mật cần mã
/// hoá, và để chung thì mọi truy vấn User bình thường đều kéo nó theo.
model TotpCredential {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Bí mật đã mã hoá bằng khoá ứng dụng, KHÔNG phải base32 thô.
  secretEnc   String
  /// NULL = đã tạo nhưng người dùng chưa nhập đúng mã lần đầu. Chưa xác nhận
  /// thì KHÔNG được coi là đã bật 2FA, nếu không người dùng tự khoá mình ra.
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Mã dự phòng dùng MỘT LẦN, cho trường hợp mất thiết bị TOTP.
model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chỉ lưu hash. Mã thô hiện đúng một lần lúc sinh ra.
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Token một lần gửi qua email.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  /// HASH của token, không phải token. Rò một bản sao DB thì không được phép
  /// biến thành khả năng đặt lại mật khẩu của mọi tài khoản đang chờ.
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Challenge WebAuthn đang chờ trả lời.
///
/// Phải có TRẠNG THÁI: giao thức yêu cầu máy chủ tự nhớ challenge nó vừa phát
/// và đối chiếu với cái quay về. Gửi challenge kèm chữ ký cho client giữ hộ sẽ
/// phá đúng tính chất mà challenge tồn tại để bảo đảm — chống phát lại.
///
/// `userId` NULL được: lúc đăng nhập bằng passkey khám phá được, máy chủ chưa
/// biết đó là ai cho tới khi chữ ký được kiểm xong.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String
  /// 'register' | 'login'. Không dùng chung challenge giữa hai luồng.
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Nhật ký thử đăng nhập, phục vụ giới hạn tần suất theo IP.
///
/// Nằm ở DB chứ không phải Redis vì .env.production.example khai REDIS_URL
/// nhưng Render KHÔNG có instance Redis nào và không dòng mã nào đọc biến đó.
/// Thà chậm hơn một chút còn hơn một lớp phòng thủ chỉ tồn tại trên giấy.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// IP hoặc tên đăng nhập — trục nào đang bị đếm.
  identifier String
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Content: Blog & Docs
// ---------------------------------------------------------------------------
model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  contentMd String
  tags      String[] @default([])
  published Boolean  @default(true)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

model Doc {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  contentMd String
  category  String   @default("general")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, position])
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------
model FileObject {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  contentType String
  size        Int      @default(0)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Trust Seal — Nhà cung cấp Con dấu tín nhiệm
//
// Vòng đời: tổ chức đăng ký -> xác minh sở hữu domain -> nộp đơn theo chương
// trình -> kiểm tra tự động + admin duyệt -> cấp chứng chỉ (có serial, hạn,
// chữ ký Ed25519) -> tái kiểm định kỳ -> gia hạn / treo / thu hồi.
//
// Chương trình dấu để trong BẢNG chứ không phải enum: thêm loại dấu mới chỉ là
// thêm một dòng dữ liệu, không cần migration.
// ---------------------------------------------------------------------------

enum TrustOrgStatus {
  ACTIVE
  SUSPENDED
}

enum DomainVerifyMethod {
  DNS_TXT
  META_TAG
  FILE
}

enum DomainVerifyStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum SealApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CertificateStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

/// Cơ sở đánh giá — in trên trang xác thực để người đọc biết con dấu dựa vào
/// đâu. Cấp dấu pháp lý mà chỉ SELF_DECLARED là rủi ro, nên admin phải chọn.
enum AssessmentBasis {
  SELF_DECLARED
  EVIDENCE_REVIEWED
  AUDITED
}

/// Tổ chức/khách hàng đứng tên xin cấp dấu. Gắn với một tài khoản tsudev.
model TrustOrganization {
  id           String         @id @default(cuid())
  ownerUserId  String
  ownerName    String
  name         String
  legalName    String?
  country      String?
  contactEmail String
  websiteUrl   String?
  status       TrustOrgStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  domains      TrustDomain[]
  applications SealApplication[]
  certificates TrustCertificate[]

  @@index([ownerUserId])
}

/// Một hostname thuộc tổ chức. Chỉ domain đã VERIFIED mới được nộp đơn.
model TrustDomain {
  id            String             @id @default(cuid())
  orgId         String
  org           TrustOrganization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hostname      String             @unique
  method        DomainVerifyMethod @default(DNS_TXT)
  /// Token ngẫu nhiên khách phải đặt vào DNS/meta/file để chứng minh quyền kiểm soát.
  token         String
  status        DomainVerifyStatus @default(PENDING)
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())

  applications SealApplication[]
  certificates TrustCertificate[]

  @@index([orgId])
  @@index([status])
}

/// Chương trình dấu (copyright-verified, ownership-attested, ...).
model SealProgram {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  summary      String
  /// Danh sách tiêu chí công khai, dạng [{ key, label, detail }].
  criteria     Json
  /// Loại bằng chứng bắt buộc, dạng [{ kind, label, required }].
  evidenceSpec Json
  validityDays Int     @default(365)
  /// Phí nộp đơn tính bằng credits (User.credits).
  feeCredits   Int     @default(0)
  /// Biến thể huy hiệu: quyết định màu/nhãn khi render SVG.
  badgeVariant String  @default("default")
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  applications SealApplication[]
  certificates TrustCertificate[]
}

/// Đơn xin cấp dấu.
model SealApplication {
  id           String                @id @default(cuid())
  orgId        String
  org          TrustOrganization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainId     String
  domain       TrustDomain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  programId    String
  program      SealProgram           @relation(fields: [programId], references: [id])
  applicantId  String
  status       SealApplicationStatus @default(DRAFT)
  /// Phạm vi khẳng định, in nguyên văn lên chứng chỉ và trang xác thực.
  scope        String?
  /// Câu trả lời của khách cho từng tiêu chí, dạng { [criteriaKey]: value }.
  answers      Json?
  feeCharged   Int                   @default(0)
  submittedAt  DateTime?
  reviewerId   String?
  reviewerName String?
  reviewNote   String?
  decidedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  evidence    SealEvidence[]
  certificate TrustCertificate?

  @@index([status, submittedAt])
  @@index([orgId])
  @@index([applicantId])
}

/// Bằng chứng khách nộp kèm đơn (link, file trong storage-service, hoặc ghi chú).
model SealEvidence {
  id            String          @id @default(cuid())
  applicationId String
  application   SealApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String
  label         String?
  url           String?
  fileObjectId  String?
  note          String?
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

/// Chứng chỉ đã cấp. `signature` là JWS Ed25519 của `payload` — bên thứ ba xác
/// minh offline được bằng khoá công khai ở /.well-known/tsudev-trust-jwks.json.
model TrustCertificate {
  id              String            @id @default(cuid())
  /// Serial người đọc được, ví dụ TSU-CR-2026-000123.
  serial          String            @unique
  applicationId   String            @unique
  application     SealApplication   @relation(fields: [applicationId], references: [id])
  orgId           String
  org             TrustOrganization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainId        String
  domain          TrustDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  programId       String
  program         SealProgram       @relation(fields: [programId], references: [id])
  status          CertificateStatus @default(ACTIVE)
  basis           AssessmentBasis   @default(EVIDENCE_REVIEWED)
  scope           String
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?
  /// Nội dung đã ký, công khai trên trang xác thực.
  payload         Json
  signature       String
  /// `kid` của khoá đã ký — cho phép xoay khoá mà chứng chỉ cũ vẫn xác minh được.
  signingKeyId    String
  issuedById      String
  issuedByName    String
  lastCheckAt     DateTime?
  lastCheckPassed Boolean?

  checks TrustCheck[]

  @@index([status, expiresAt])
  @@index([domainId])
  @@index([orgId])
}

/// Kết quả tái kiểm định kỳ (domain còn trỏ đúng, token còn đó, TLS còn hạn...).
model TrustCheck {
  id            String           @id @default(cuid())
  certificateId String
  certificate   TrustCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  ranAt         DateTime         @default(now())
  passed        Boolean
  details       Json?

  @@index([certificateId, ranAt])
}

/// Nhật ký bất biến cho mọi hành động trên hệ thống dấu — theo đúng khuôn mẫu
/// ModAction của kiểm duyệt. Cần cho trách nhiệm pháp lý khi cấp dấu.
model TrustAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Dự án & bản quyền — trọng tâm mới của website
//
// Mỗi dòng là một dự án/tool/phần mềm do tsudev phát triển. Ba nhóm trường:
// giới thiệu, phát hành, và bản quyền. Nhóm bản quyền là cầu nối sang Con dấu
// tín nhiệm: dự án có bản quyền -> website dùng dự án đó -> được cấp huy hiệu.
// ---------------------------------------------------------------------------

enum ProjectKind {
  APP
  TOOL
  LIBRARY
  SERVICE
}

enum ProjectStatus {
  WIP
  BETA
  STABLE
  ARCHIVED
}

/// NONE: chưa nộp · PENDING: đã nộp, đang chờ · REGISTERED: đã có giấy chứng nhận.
enum CopyrightStatus {
  NONE
  PENDING
  REGISTERED
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  summary       String
  descriptionMd String        @default("")
  kind          ProjectKind   @default(TOOL)
  status        ProjectStatus @default(WIP)

  // Phát hành
  version     String?
  releasedAt  DateTime?
  repoUrl     String?
  homepageUrl String?
  downloadUrl String?
  /// Mã giấy phép theo SPDX (MIT, Apache-2.0, ...). Để trống nghĩa là chưa công bố.
  license     String?

  // Bản quyền
  copyrightStatus CopyrightStatus @default(NONE)
  /// Số giấy chứng nhận đăng ký quyền tác giả. Chỉ có nghĩa khi status=REGISTERED.
  copyrightNo     String?
  copyrightAt     DateTime?
  copyrightOwner  String?

  /// Nối sang chương trình dấu tương ứng. Cố ý KHÔNG phải quan hệ khoá ngoại:
  /// dự án tồn tại độc lập, chương trình dấu có thể chưa được tạo, và xoá một
  /// chương trình không được phép kéo theo dự án.
  trustProgramSlug String?

  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([kind, status])
  @@index([copyrightStatus])
}
