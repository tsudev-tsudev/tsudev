// tsudev - Prisma schema
// Nền tảng dữ liệu chung cho toàn hệ thống (users, blog, docs, files, con dấu).
// Provider: PostgreSQL. Local dev chạy trên cluster user-space (port 5433).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  MEMBER
  VIP
  AUTHOR
  MODERATOR
  ADMIN
  OWNER
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Xác thực do codebase tự quản lý ---
  //
  // NULL được: tài khoản chỉ đăng nhập bằng GitHub/Google hoặc chỉ bằng passkey
  // thì không có mật khẩu nào cả. Đừng suy ra "chưa đăng ký" từ cột này.
  /// Argon2id. KHÔNG BAO GIỜ trả cột này ra khỏi tầng service.
  passwordHash     String?
  /// NULL = email chưa xác minh. Đường ghi nhạy cảm phải tự kiểm, vì tài khoản
  /// vẫn tồn tại và vẫn đăng nhập được trước khi xác minh.
  emailVerifiedAt  DateTime?
  /// Thu hồi phiên mà không cần bảng phiên. JWT mang số này; đổi mật khẩu hoặc
  /// "đăng xuất mọi thiết bị" thì tăng lên, và mọi token đã phát mất hiệu lực
  /// ngay. Phiên lưu DB sẽ đúng hơn về lý thuyết nhưng frontend chạy trên
  /// Cloudflare Workers còn DB ở Neon ap-southeast-1 - nghĩa là một truy vấn
  /// xuyên lục địa cho MỖI request.
  sessionVersion   Int       @default(0)
  /// Vô hiệu hoá MỀM do chính chủ: tài khoản ẩn/không dùng được, nhưng đăng nhập
  /// lại sẽ KHÔI PHỤC (xoá mốc này). NULL = đang hoạt động.
  deactivatedAt    DateTime?
  /// Hẹn XOÁ vĩnh viễn: đăng nhập lại trước mốc này thì huỷ hẹn (khôi phục);
  /// quá mốc mà đăng nhập thì tài khoản bị purge. NULL = không hẹn xoá.
  deletionScheduledAt DateTime?
  /// Đếm số lần sai LIÊN TIẾP; đăng nhập thành công đặt lại về 0.
  failedLoginCount Int       @default(0)
  /// Khoá tạm sau quá nhiều lần sai. Khoá theo TÀI KHOẢN, khác với chặn theo IP
  /// ở LoginAttempt - thiếu một trong hai thì kẻ tấn công chỉ cần đổi trục.
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  /// --- Dấu vết đăng nhập gần nhất, PHI CHUẨN HOÁ có chủ đích ---
  ///
  /// Ba cột này lặp lại thông tin đã có trong `SecurityEvent` của lần đăng nhập
  /// cuối. Lặp là cố ý: trang quản trị lọc theo IP/quốc gia/phương pháp trên
  /// hàng nghìn tài khoản, mà lấy chúng từ `SecurityEvent` nghĩa là "sự kiện mới
  /// nhất của từng người" - một truy vấn con cho MỖI dòng, và không lọc bằng
  /// chỉ mục được. Ghi thẳng vào đây ở đúng chỗ đang ghi `lastLoginAt` thì bộ
  /// lọc thành một câu WHERE có chỉ mục.
  ///
  /// `SecurityEvent` vẫn là sổ cái đầy đủ; ba cột này chỉ là ảnh chụp cuối cùng.
  /// Chúng PHẢI được ghi cùng lúc với `lastLoginAt`, không bao giờ tách ra -
  /// lệch nhau là trang quản trị nói một đằng, nhật ký bảo mật nói một nẻo.
  lastLoginIp      String?
  /// Mã quốc gia ISO-3166-1 alpha-2 do Cloudflare cấp (`CF-IPCountry`). Hai ký
  /// tự, hoặc "XX" khi Cloudflare không xác định được. KHÔNG suy ra từ IP ở đây
  /// - việc đó cần cơ sở dữ liệu GeoIP, để dành cho pha sau.
  lastLoginCountry String?
  /// 'password' | 'passkey' | 'oauth:github' | 'oauth:google'. Chuỗi chứ không
  /// enum: thêm nhà cung cấp là dữ liệu, không phải migration - giống hệt lý do
  /// `OAuthAccount.provider` là chuỗi.
  lastLoginMethod  String?

  posts Post[]
  files FileObject[]

  oauthAccounts OAuthAccount[]
  passkeys      WebAuthnCredential[]
  totp          TotpCredential?
  backupCodes   BackupCode[]
  authTokens    AuthToken[]
  securityEvents SecurityEvent[]

  trustInviteRedemptions TrustInviteRedemption[]
  emailAliases           EmailAlias[]

  /// Trang quản trị lọc và sắp theo ba trục này. Không có chỉ mục thì mỗi lần
  /// lọc là một lượt quét toàn bảng.
  @@index([lastLoginAt])
  @@index([lastLoginCountry])
  @@index([role, createdAt])
}

/// Tài khoản bên thứ ba đã liên kết (GitHub, Google). Một User có thể liên kết
/// nhiều nhà cung cấp; mỗi tài khoản bên đó chỉ gắn được vào MỘT User.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "github" | "google" - chuỗi chứ không phải enum: thêm nhà cung cấp là dữ
  /// liệu, không phải migration.
  provider          String
  /// Định danh ổn định do nhà cung cấp cấp. KHÔNG dùng email làm khoá - email
  /// đổi được, và tin vào email của bên thứ ba là đường chiếm tài khoản.
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Passkey / WebAuthn.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// credentialId do trình duyệt cấp, lưu dạng base64url.
  credentialId String    @unique
  publicKey    String
  /// Bộ đếm chống phát lại: giá trị mới phải LỚN HƠN giá trị đã lưu.
  counter      Int       @default(0)
  transports   String[]  @default([])
  /// Nhãn người dùng đặt để tự phân biệt thiết bị khi thu hồi.
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Bí mật TOTP. Bảng riêng chứ không phải cột trên User: nó là bí mật cần mã
/// hoá, và để chung thì mọi truy vấn User bình thường đều kéo nó theo.
model TotpCredential {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Bí mật đã mã hoá bằng khoá ứng dụng, KHÔNG phải base32 thô.
  secretEnc   String
  /// NULL = đã tạo nhưng người dùng chưa nhập đúng mã lần đầu. Chưa xác nhận
  /// thì KHÔNG được coi là đã bật 2FA, nếu không người dùng tự khoá mình ra.
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Mã dự phòng dùng MỘT LẦN, cho trường hợp mất thiết bị TOTP.
model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chỉ lưu hash. Mã thô hiện đúng một lần lúc sinh ra.
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  /// Đổi email: token gửi tới địa chỉ MỚI, tiêu token thì mới thay `User.email`.
  /// Địa chỉ đích nằm ở `AuthToken.newEmail` - xác minh trước, thay sau.
  EMAIL_CHANGE
}

/// Token một lần gửi qua email.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  /// HASH của token, không phải token. Rò một bản sao DB thì không được phép
  /// biến thành khả năng đặt lại mật khẩu của mọi tài khoản đang chờ.
  tokenHash String           @unique
  /// Chỉ dùng với purpose EMAIL_CHANGE: địa chỉ email MỚI đang chờ xác minh.
  /// NULL với các purpose khác. Lưu ở token (không phải ở User) để email hiện
  /// tại không bị đổi trước khi chủ tài khoản chứng minh quyền kiểm soát địa chỉ
  /// mới - "xác minh trước, thay sau".
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Challenge WebAuthn đang chờ trả lời.
///
/// Phải có TRẠNG THÁI: giao thức yêu cầu máy chủ tự nhớ challenge nó vừa phát
/// và đối chiếu với cái quay về. Gửi challenge kèm chữ ký cho client giữ hộ sẽ
/// phá đúng tính chất mà challenge tồn tại để bảo đảm - chống phát lại.
///
/// `userId` NULL được: lúc đăng nhập bằng passkey khám phá được, máy chủ chưa
/// biết đó là ai cho tới khi chữ ký được kiểm xong.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String
  /// 'register' | 'login'. Không dùng chung challenge giữa hai luồng.
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Nhật ký thử đăng nhập, phục vụ giới hạn tần suất theo IP.
///
/// Nằm ở DB chứ không phải Redis vì .env.production.example khai REDIS_URL
/// nhưng Render KHÔNG có instance Redis nào và không dòng mã nào đọc biến đó.
/// Thà chậm hơn một chút còn hơn một lớp phòng thủ chỉ tồn tại trên giấy.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// IP hoặc tên đăng nhập - trục nào đang bị đếm.
  identifier String
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([createdAt])
}

/// Nhật ký sự kiện bảo mật của tài khoản: đăng nhập, đổi mật khẩu/email, bật/tắt
/// 2FA, thêm/xoá passkey. Bề mặt cho chính chủ ("Hoạt động gần đây") và cho OWNER
/// (console xuyên tài khoản).
///
/// TÁCH RIÊNG khỏi `TrustAuditLog` có chủ đích: TrustAuditLog phục vụ trách nhiệm
/// pháp lý của Con dấu và có console OWNER đọc 100 dòng gần nhất - đổ mọi lượt
/// đăng nhập vào đó sẽ nhấn chìm sự kiện Con dấu. Sự kiện admin/vai trò
/// (invite.*, user.*) vẫn ở TrustAuditLog; bảng này chỉ giữ sự kiện tự-phục-vụ.
/// Bí danh thư nội bộ `*@tsudev.com`, đối chiếu với Cloudflare Email Routing.
///
/// Đây là BẢN SAO, không phải nguồn sự thật. Nguồn sự thật là Cloudflare: thư
/// đi theo quy tắc bên đó, không theo bảng này. Bảng này tồn tại để trang quản
/// trị gắn được bí danh với TÀI KHOẢN (thứ Cloudflare không biết) và để hiện
/// danh sách mà không phải gọi API ở mỗi lần tải trang.
///
/// Hai bên lệch nhau là chuyện BÌNH THƯỜNG - ai đó sửa tay trên bảng điều khiển
/// Cloudflare là lệch. Vì thế có thao tác đối soát, và mọi chỗ đọc phải coi
/// `cfRuleId = NULL` là "chưa tồn tại thật", không phải "sắp có".
model EmailAlias {
  id String @id @default(cuid())

  /// Phần trước dấu @, đã chuẩn hoá về chữ thường: `lien-he` cho
  /// lien-he@tsudev.com. Lưu riêng phần này chứ không lưu cả địa chỉ vì tên
  /// miền là cấu hình (`INTERNAL_MAIL_DOMAIN`), không phải dữ liệu.
  localPart String @unique

  /// Hộp thư nhận chuyển tiếp. Cloudflare CHỈ chuyển tới địa chỉ đã xác minh ở
  /// phía họ - đặt một địa chỉ chưa xác minh thì quy tắc tạo ra vẫn im lặng
  /// không giao thư.
  destination String

  /// Định danh quy tắc bên Cloudflare. NULL = bảng này có mà Cloudflare KHÔNG -
  /// bí danh chưa sống, thư gửi tới sẽ trả về. Trạng thái này phải nhìn thấy
  /// được trên giao diện, đừng ẩn nó đi.
  cfRuleId String?

  /// Tài khoản sở hữu. NULL = bí danh dùng chung (lien-he@, bao-mat@) không
  /// thuộc riêng ai.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SecurityEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ai THỰC HIỆN, nếu khác chủ tài khoản (OWNER thao tác lên user khác). NULL =
  /// chính chủ. Lưu kèm `actorName` để hiện được mà không cần join.
  actorId   String?
  actorName String?
  /// Mã sự kiện ổn định: 'login', 'password_change', 'email_changed'... Chuỗi
  /// chứ không enum - thêm loại sự kiện là dữ liệu, không phải migration.
  type      String
  /// IP và User-Agent của người gây ra sự kiện, để chủ tài khoản nhận ra đăng
  /// nhập bất thường. Dữ liệu cá nhân - chỉ chủ tài khoản và OWNER đọc được.
  ip        String?
  /// Mã quốc gia ISO-3166-1 alpha-2 lấy từ header `CF-IPCountry` của Cloudflare
  /// - miễn phí và chính xác vì frontend vốn đã chạy trên Workers. NULL với mọi
  /// sự kiện ghi TRƯỚC khi cột này ra đời, và với lời gọi không đi qua tầng
  /// biên (test, kịch bản nội bộ). Đừng suy ra quốc gia từ `ip` ở tầng đọc: dữ
  /// liệu cũ sẽ im lặng khác dữ liệu mới.
  country   String?
  userAgent String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Content: Blog & Docs
// ---------------------------------------------------------------------------
model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  contentMd String
  tags      String[] @default([])
  published Boolean  @default(true)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Xuất bản & lên lịch ---
  /// NGÀY HIỂN THỊ, do tác giả sửa được. `createdAt` giữ nguyên làm dấu vết audit
  /// bất biến. Mọi đường đọc công khai xếp/lọc theo trường này (fallback createdAt
  /// nếu NULL cho dữ liệu cũ). LÊN LỊCH: `published=true` + `publishedAt` tương lai
  /// ⇒ bài ẩn tới giờ hẹn - đường đọc công khai PHẢI thêm `publishedAt <= now()`.
  publishedAt DateTime?

  /// --- Nội dung nâng cao ---
  /// Nguồn tham khảo: mảng JSON [{ label, url }]. Render ở vùng "Nguồn tham khảo".
  references      Json?
  /// Ảnh bìa (URL trong object storage). Hiển thị đầu bài + thẻ OG.
  coverImageUrl   String?
  /// Mô tả SEO/OG. Rỗng ⇒ suy từ excerpt.
  metaDescription String?

  /// --- Chỉ mục tìm kiếm (SEARCH_AND_FILTER.md) ---
  /// Bản đã CHUẨN HOÁ (NFC → thường → bỏ dấu, đ→d) để so khớp không dấu. TÍNH SẴN
  /// tại thời điểm ghi qua @tsudev/search, KHÔNG tìm trực tiếp trên title/contentMd.
  /// Backfill bằng `npm run search:reindex`. Có index GIN pg_trgm (thêm ở migration).
  searchTitleNorm String?
  searchBodyNorm  String?

  /// --- Toà soạn Agent AI ---
  /// Xoá mềm. Mọi truy vấn đọc công khai PHẢI thêm `deletedAt: null`; quên một
  /// chỗ là bài đã xoá vẫn hiện ra. Xoá cứng bị trigger Postgres chặn.
  deletedAt         DateTime?
  /// Bản nháp đã sinh ra bản ghi này, để lần ngược về lịch sử phiên bản.
  sourceDraftId     String?
  /// AgentProfile.id của agent đã viết. NULL = do người viết (dữ liệu seed cũ).
  authoredByAgentId String?

  @@index([published, createdAt])
  @@index([published, publishedAt])
  @@index([deletedAt])
  @@index([tags], type: Gin)
  // Index trigram trên cột đã chuẩn hoá - so khớp không dấu/gần đúng không quét
  // toàn bảng. `map` khớp tên index dựng tay trong migration để Prisma không báo lệch.
  @@index([searchTitleNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_searchTitleNorm_trgm_idx")
  @@index([searchBodyNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_searchBodyNorm_trgm_idx")
}

model Doc {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  contentMd String
  category  String   @default("general")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Chỉ mục tìm kiếm (SEARCH_AND_FILTER.md) ---
  /// Giống hệt cặp cột của Post và vì đúng lý do đó: bản đã CHUẨN HOÁ (NFC →
  /// thường → bỏ dấu, đ→d) để so khớp không dấu, TÍNH SẴN lúc GHI qua
  /// @tsudev/search. Doc không có cột tóm tắt nên `searchBodyNorm` chỉ gộp thân
  /// bài đã rút văn bản thuần. Backfill bằng `npm run search:reindex` (script đó
  /// lập chỉ mục CẢ Post lẫn Doc). Có index GIN pg_trgm (thêm ở migration).
  searchTitleNorm String?
  searchBodyNorm  String?

  /// --- Toà soạn Agent AI ---
  /// Xoá mềm. Mọi truy vấn đọc công khai PHẢI thêm `deletedAt: null`; quên một
  /// chỗ là bài đã xoá vẫn hiện ra. Xoá cứng bị trigger Postgres chặn.
  deletedAt         DateTime?
  /// Bản nháp đã sinh ra bản ghi này, để lần ngược về lịch sử phiên bản.
  sourceDraftId     String?
  /// AgentProfile.id của agent đã viết. NULL = do người viết (dữ liệu seed cũ).
  authoredByAgentId String?

  @@index([category, position])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------
model FileObject {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  contentType String
  size        Int      @default(0)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Trust Seal - Nhà cung cấp Con dấu tín nhiệm
//
// Vòng đời: tổ chức đăng ký -> xác minh sở hữu domain -> nộp đơn theo chương
// trình -> kiểm tra tự động + admin duyệt -> cấp chứng chỉ (có serial, hạn,
// chữ ký Ed25519) -> tái kiểm định kỳ -> gia hạn / treo / thu hồi.
//
// Chương trình dấu để trong BẢNG chứ không phải enum: thêm loại dấu mới chỉ là
// thêm một dòng dữ liệu, không cần migration.
// ---------------------------------------------------------------------------

enum TrustOrgStatus {
  ACTIVE
  SUSPENDED
}

enum DomainVerifyMethod {
  DNS_TXT
  META_TAG
  FILE
}

enum DomainVerifyStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum SealApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CertificateStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

/// Cơ sở đánh giá - in trên trang xác thực để người đọc biết con dấu dựa vào
/// đâu. Cấp dấu pháp lý mà chỉ SELF_DECLARED là rủi ro, nên admin phải chọn.
enum AssessmentBasis {
  SELF_DECLARED
  EVIDENCE_REVIEWED
  AUDITED
}

/// Tổ chức/khách hàng đứng tên xin cấp dấu. Gắn với một tài khoản tsudev.
model TrustOrganization {
  id           String         @id @default(cuid())
  ownerUserId  String
  ownerName    String
  name         String
  legalName    String?
  country      String?
  contactEmail String
  websiteUrl   String?
  status       TrustOrgStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  domains      TrustDomain[]
  applications SealApplication[]
  certificates TrustCertificate[]

  @@index([ownerUserId])
}

/// Một hostname thuộc tổ chức. Chỉ domain đã VERIFIED mới được nộp đơn.
model TrustDomain {
  id            String             @id @default(cuid())
  orgId         String
  org           TrustOrganization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hostname      String             @unique
  method        DomainVerifyMethod @default(DNS_TXT)
  /// Token ngẫu nhiên khách phải đặt vào DNS/meta/file để chứng minh quyền kiểm soát.
  token         String
  status        DomainVerifyStatus @default(PENDING)
  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())

  applications SealApplication[]
  certificates TrustCertificate[]

  @@index([orgId])
  @@index([status])
}

/// Chương trình dấu (copyright-verified, ownership-attested, ...).
model SealProgram {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  summary      String
  /// Danh sách tiêu chí công khai, dạng [{ key, label, detail }].
  criteria     Json
  /// Loại bằng chứng bắt buộc, dạng [{ kind, label, required }].
  evidenceSpec Json
  validityDays Int     @default(365)
  /// Biến thể huy hiệu: quyết định màu/nhãn khi render SVG.
  badgeVariant String  @default("default")
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  applications SealApplication[]
  certificates TrustCertificate[]
}

/// Đơn xin cấp dấu.
model SealApplication {
  id           String                @id @default(cuid())
  orgId        String
  org          TrustOrganization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainId     String
  domain       TrustDomain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  programId    String
  program      SealProgram           @relation(fields: [programId], references: [id])
  applicantId  String
  status       SealApplicationStatus @default(DRAFT)
  /// Phạm vi khẳng định, in nguyên văn lên chứng chỉ và trang xác thực.
  scope        String?
  /// Câu trả lời của khách cho từng tiêu chí, dạng { [criteriaKey]: value }.
  answers      Json?
  submittedAt  DateTime?
  reviewerId   String?
  reviewerName String?
  reviewNote   String?
  decidedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  evidence    SealEvidence[]
  certificate TrustCertificate?

  @@index([status, submittedAt])
  @@index([orgId])
  @@index([applicantId])
}

/// Bằng chứng khách nộp kèm đơn (link, file trong storage-service, hoặc ghi chú).
model SealEvidence {
  id            String          @id @default(cuid())
  applicationId String
  application   SealApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String
  label         String?
  url           String?
  fileObjectId  String?
  note          String?
  createdAt     DateTime        @default(now())

  @@index([applicationId])
}

/// Chứng chỉ đã cấp. `signature` là JWS Ed25519 của `payload` - bên thứ ba xác
/// minh offline được bằng khoá công khai ở /.well-known/tsudev-trust-jwks.json.
model TrustCertificate {
  id              String            @id @default(cuid())
  /// Serial người đọc được, ví dụ TSU-CR-2026-000123.
  serial          String            @unique
  applicationId   String            @unique
  application     SealApplication   @relation(fields: [applicationId], references: [id])
  orgId           String
  org             TrustOrganization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domainId        String
  domain          TrustDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  programId       String
  program         SealProgram       @relation(fields: [programId], references: [id])
  status          CertificateStatus @default(ACTIVE)
  basis           AssessmentBasis   @default(EVIDENCE_REVIEWED)
  scope           String
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?
  /// Nội dung đã ký, công khai trên trang xác thực.
  payload         Json
  signature       String
  /// `kid` của khoá đã ký - cho phép xoay khoá mà chứng chỉ cũ vẫn xác minh được.
  signingKeyId    String
  issuedById      String
  issuedByName    String
  lastCheckAt     DateTime?
  lastCheckPassed Boolean?

  checks TrustCheck[]

  @@index([status, expiresAt])
  @@index([domainId])
  @@index([orgId])
}

/// Kết quả tái kiểm định kỳ (domain còn trỏ đúng, token còn đó, TLS còn hạn...).
model TrustCheck {
  id            String           @id @default(cuid())
  certificateId String
  certificate   TrustCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  ranAt         DateTime         @default(now())
  passed        Boolean
  details       Json?

  @@index([certificateId, ranAt])
}

/// Nhật ký bất biến cho mọi hành động trên hệ thống dấu - theo đúng khuôn mẫu
/// ModAction của kiểm duyệt. Cần cho trách nhiệm pháp lý khi cấp dấu.
model TrustAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Mã mời vào Con dấu tín nhiệm
//
// Con dấu là vùng chỉ-dành-cho-khách-mời: đổi mã hợp lệ = được nâng lên
// `Role.VIP`, và `requireRole('VIP')` ở trust-service là cổng thật. CỐ Ý dùng
// lại `Role` thay vì thêm cột `trustAccess` riêng - một hệ phân quyền thứ hai
// chạy song song với hệ đã có đúng là thứ đã sinh ra vụ REQUIRE_ROLE_ENFORCEMENT.
// ---------------------------------------------------------------------------

model TrustInvite {
  id          String    @id @default(cuid())
  /// CHỈ lưu SHA-256. Cùng lý do với AuthToken.tokenHash và BackupCode.codeHash:
  /// một bản sao DB bị rò không được phép biến thành một xấp mã mời dùng được.
  ///
  /// SHA-256 chứ không phải Argon2id, và đó là đúng: mã do CSPRNG sinh, entropy
  /// cao, không có gì để dò. Argon2 chỉ cần khi đầu vào là thứ người tự đặt.
  codeHash    String    @unique
  /// Nhãn cho người vận hành: "Đối tác ABC", "Hội thảo 09/2026". Không bao giờ
  /// hiện ra cho người đổi mã.
  label       String
  /// Mã dùng nhiều lần (một đối tác) hay một lần (một người).
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  /// NULL = không hết hạn.
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  /// Thu hồi là đặt mốc thời gian, không phải xoá dòng: lịch sử đổi mã phải còn
  /// tra được sau khi mã bị thu hồi.
  revokedAt   DateTime?

  redemptions TrustInviteRedemption[]

  @@index([createdAt])
}

/// Ai đã đổi mã nào, lúc nào. Cần cho trách nhiệm pháp lý khi cấp dấu - cùng lý
/// do TrustAuditLog tồn tại.
model TrustInviteRedemption {
  id        String      @id @default(cuid())
  inviteId  String
  invite    TrustInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  /// Chặn một người đổi CÙNG một mã nhiều lần để đốt lượt của người khác.
  @@unique([inviteId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Dự án & bản quyền - trọng tâm mới của website
//
// Mỗi dòng là một dự án/tool/phần mềm do tsudev phát triển. Ba nhóm trường:
// giới thiệu, phát hành, và bản quyền. Nhóm bản quyền là cầu nối sang Con dấu
// tín nhiệm: dự án có bản quyền -> website dùng dự án đó -> được cấp huy hiệu.
// ---------------------------------------------------------------------------

enum ProjectKind {
  APP
  TOOL
  LIBRARY
  SERVICE
}

enum ProjectStatus {
  WIP
  BETA
  STABLE
  ARCHIVED
}

/// NONE: chưa nộp · PENDING: đã nộp, đang chờ · REGISTERED: đã có giấy chứng nhận.
enum CopyrightStatus {
  NONE
  PENDING
  REGISTERED
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  summary       String
  descriptionMd String        @default("")
  kind          ProjectKind   @default(TOOL)
  status        ProjectStatus @default(WIP)

  // Phát hành
  version     String?
  releasedAt  DateTime?
  repoUrl     String?
  homepageUrl String?
  downloadUrl String?
  /// Mã giấy phép theo SPDX (MIT, Apache-2.0, ...). Để trống nghĩa là chưa công bố.
  license     String?

  // Bản quyền
  copyrightStatus CopyrightStatus @default(NONE)
  /// Số giấy chứng nhận đăng ký quyền tác giả. Chỉ có nghĩa khi status=REGISTERED.
  copyrightNo     String?
  copyrightAt     DateTime?
  copyrightOwner  String?

  /// Nối sang chương trình dấu tương ứng. Cố ý KHÔNG phải quan hệ khoá ngoại:
  /// dự án tồn tại độc lập, chương trình dấu có thể chưa được tạo, và xoá một
  /// chương trình không được phép kéo theo dự án.
  trustProgramSlug String?

  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Toà soạn Agent AI ---
  /// Xoá mềm, thêm ở đợt 5. Route DELETE /api/admin/projects/:slug đã đổi sang
  /// đặt cột này TRƯỚC khi trigger chặn xoá cứng được gắn cho bảng Project -
  /// đảo thứ tự là làm hỏng một tính năng đang chạy được.
  deletedAt DateTime?

  @@index([published, sortOrder])
  @@index([deletedAt])
  @@index([kind, status])
  @@index([copyrightStatus])
}

// ---------------------------------------------------------------------------
// Toà soạn Agent AI (Newsroom)
//
// Kế hoạch đầy đủ: docs/refactor-newsroom-agents.md
//
// Nguyên tắc nền của cụm này, đừng phá khi sửa về sau:
//   1. Agent làm việc trên ContentDraft, KHÔNG trên Post. Publish là phép chiếu
//      draft -> Post/Doc. Nhờ vậy đường đọc công khai không đổi một dòng nào và
//      tắt cả hệ agent thì site vẫn chạy y nguyên.
//   2. NewsroomEvent là hàng đợi sự kiện VÀ nhật ký kiểm toán. Append-only.
//      Không có đường UPDATE nội dung, chỉ đổi `status` khi claim/hoàn tất.
//   3. Agent KHÔNG phải User và không có phiên đăng nhập. Enum Role không được
//      thêm giá trị nào cho agent - phân quyền vẫn chỉ có một nguồn là
//      User.role qua @tsudev/auth.
//   4. Không bảng nào ở đây được xoá cứng. Trigger Postgres chặn DELETE; xoá là
//      đặt deletedAt. Xem migration ..._newsroom_no_hard_delete.
// ---------------------------------------------------------------------------

enum AgentDept {
  RESEARCH
  EDITORIAL
  PUBLISHING
  SEO
}

enum AgentStatus {
  IDLE
  PLANNING
  SCANNING
  WRITING
  REVIEWING
  SUSPENDED
}

enum DraftStatus {
  IDEA
  IN_PROGRESS
  PENDING_REVIEW
  PENDING_HUMAN
  REJECTED_WITH_FEEDBACK
  PUBLISHED
  ARCHIVED
}

enum DraftTarget {
  BLOG
  DOC
  PROJECT
  TRUST
}

enum Autonomy {
  FULL_AUTO
  HUMAN_APPROVAL
  DRAFT_ONLY
}

enum NewsroomEventStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
  DEAD
}

model AgentProfile {
  id          String    @id @default(cuid())
  slug        String    @unique
  displayName String
  title       String
  dept        AgentDept
  /// Hạt giống sinh avatar định danh phía client. Cố ý KHÔNG dùng ảnh upload:
  /// tránh kéo storage-service vào một tính năng không cần nó.
  avatarSeed  String

  /// "workers-ai" | "gemini". Adapter tra bản cài theo giá trị này.
  /// KHÔNG phải enum: thêm nhà cung cấp mới không nên cần migration.
  provider     String @default("workers-ai")
  model        String @default("@cf/meta/llama-3.3-70b-instruct-fp8-fast")
  systemPrompt String

  status      AgentStatus @default(IDLE)
  /// Câu mô tả việc đang làm, hiện trên sàn ảo. Ví dụ "đang quét Hacker News".
  statusNote  String?
  /// SUSPEND_AGENT - chỉ ADMIN đặt được. Dispatcher bỏ qua agent bị treo.
  suspendedAt DateTime?
  enabled     Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs   AgentRun[]
  drafts ContentDraft[] @relation("draftAuthorAgent")

  @@index([dept, status])
}

/// Cấu hình mức tự chủ theo chuyên mục. Mặc định FULL_AUTO cho cả bốn theo
/// quyết định của chủ dự án 18/08/2026; đổi sang HUMAN_APPROVAL là một câu
/// UPDATE, không cần phát hành lại.
model NewsroomChannel {
  id           String      @id @default(cuid())
  target       DraftTarget @unique
  autonomy     Autonomy    @default(FULL_AUTO)
  /// Hướng dẫn giọng văn cho chuyên mục này, nhét vào system prompt của Writer.
  /// Giữ NGẮN - cửa sổ ngữ cảnh của Llama 3.3 70B nhỏ hơn Claude rất nhiều.
  styleGuide   String
  dailyPostCap Int         @default(2)
  enabled      Boolean     @default(true)
  updatedAt    DateTime    @updatedAt
}

/// Nguồn săn tin. Sửa được từ dashboard, không phải hằng số trong mã.
model NewsroomSource {
  id     String      @id @default(cuid())
  label  String
  /// "rss" | "atom" | "hn_algolia" | "manual"
  kind   String
  /// NULL với kind="manual" (chủ đề do người nhập tay).
  url    String?
  target DraftTarget

  /// Nguồn báo chí: chỉ được lấy tiêu đề + mô tả + URL rồi VIẾT MỚI, không bao
  /// giờ đăng lại toàn văn. Mặc định true và không có đường tắt trong mã.
  rewriteOnly Boolean @default(true)

  enabled    Boolean   @default(true)
  lastScanAt DateTime?
  /// Lỗi lần quét gần nhất. Một nguồn hỏng KHÔNG được làm hỏng cả lượt quét.
  lastError  String?
  createdAt  DateTime  @default(now())

  ideas TopicIdea[]

  @@index([enabled, lastScanAt])
}

model TopicIdea {
  id         String      @id @default(cuid())
  title      String
  rationale  String
  target     DraftTarget
  sourceUrls String[]    @default([])

  sourceId String?
  source   NewsroomSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  score       Int    @default(0)
  /// Chống trùng chủ đề giữa các lượt quét. sha256 của tiêu đề đã chuẩn hoá.
  /// @unique là hàng phòng thủ cuối - Scout vẫn phải kiểm trước khi ghi.
  fingerprint String @unique

  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([consumedAt, score])
}

model ContentDraft {
  id     String      @id @default(cuid())
  target DraftTarget
  status DraftStatus @default(IDEA)

  slug      String?
  title     String
  excerpt   String?
  contentMd String   @default("")
  tags      String[] @default([])
  metaTitle String?
  metaDesc  String?

  topicId       String?
  authorAgentId String?
  authorAgent   AgentProfile? @relation("draftAuthorAgent", fields: [authorAgentId], references: [id], onDelete: SetNull)

  /// Đếm vòng Writer -> Editor -> Writer. Trần cứng trong mã (NEWSROOM_MAX_REVISIONS).
  /// Không có trần là đường đốt hạn mức Neuron nhanh nhất, và nó im lặng.
  revisionCount  Int     @default(0)
  reviewFeedback String?

  /// Id của bản ghi ĐÃ ĐĂNG mà bản nháp này sinh ra. Tên trường là `Ref` chứ
  /// không phải `Post` vì nó giữ id của `Post`, `Doc` HOẶC `Project` tuỳ
  /// `target` - bản đầu đặt tên theo trường hợp phổ biến nhất, và người đọc sau
  /// sẽ tin rằng mọi giá trị trong đó là id bài viết.
  ///
  /// `@map` giữ nguyên tên cột cũ trong database CÓ CHỦ ĐÍCH: đổi tên cột thật
  /// là một migration mà Prisma sinh ra dưới dạng DROP + ADD nếu không được dẫn
  /// tay, tức là mất sạch dữ liệu cột này. Cái giá phải trả cho tên đúng ở tầng
  /// mã không đáng bằng rủi ro đó; cột trong DB vẫn tên `publishedPostId` và
  /// dòng chú thích này là chỗ giải thích vì sao.
  publishedRefId  String?  @map("publishedPostId")
  /// Xoá mềm. CHỈ người đặt được - agent không có route nào chạm tới cột này.
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions DraftRevision[]

  @@index([status, target, updatedAt])
  @@index([deletedAt])
}

/// Lịch sử phiên bản bản nháp. Append-only - không có đường UPDATE nào trong mã.
model DraftRevision {
  id      String       @id @default(cuid())
  draftId String
  draft   ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  seq     Int

  title     String
  contentMd String

  /// "agent" | "human". Nhật ký phải phân biệt được ai sửa gì.
  actorKind String
  actorId   String?
  note      String?

  createdAt DateTime @default(now())

  @@unique([draftId, seq])
}

model AgentRun {
  id      String       @id @default(cuid())
  agentId String
  agent   AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  draftId String?

  /// "scan" | "write" | "review" | "seo"
  action String

  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  /// Lease chống run treo khi tiến trình restart giữa chừng. Tick mở đầu bằng
  /// một câu reclaim: quá hạn mà chưa endedAt thì event quay lại PENDING.
  leaseUntil DateTime

  ok       Boolean?
  errorMsg String?

  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  /// Neuron tiêu thụ, KHÔNG phải tiền. Hệ này không tốn tiền - đừng đặt tên cột
  /// là "cost" cho thứ không phải chi phí (bài học từ User.credits đã bị gỡ).
  neuronsUsed  Int    @default(0)
  /// Nhà cung cấp đã thực sự phục vụ lần chạy này. Cần để đọc dashboard đúng
  /// khi adapter đã chuyển sang dự phòng giữa ngày.
  usedProvider String @default("workers-ai")

  @@index([agentId, startedAt])
  @@index([leaseUntil])
}

/// Hàng đợi sự kiện + nguồn cấp dashboard + NHẬT KÝ KIỂM TOÁN, cùng một bảng.
/// Append-only về nội dung: chỉ `status`/`attempts`/`claimedAt` được đổi.
model NewsroomEvent {
  id     String              @id @default(cuid())
  /// "idea.created" | "draft.claimed" | "draft.submitted" | "review.approved"
  /// | "review.rejected" | "publish.requested" | "draft.published"
  /// | "agent.suspended" | "budget.exhausted" | "provider.switched" | ...
  type   String
  status NewsroomEventStatus @default(PENDING)

  draftId   String?
  agentId   String?
  /// "agent" | "human" | "system"
  actorKind String  @default("agent")

  payload Json

  attempts  Int       @default(0)
  claimedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([draftId, createdAt])
}
