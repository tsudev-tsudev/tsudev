  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px"
  },

  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
