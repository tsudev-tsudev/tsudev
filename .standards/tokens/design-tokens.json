  "shadow": {
    "sm": "0 1px 2px rgba(15, 27, 45, 0.06)",
    "md": "0 2px 8px rgba(15, 27, 45, 0.10)",
    "lg": "0 8px 24px rgba(15, 27, 45, 0.14)"
  },

  "z-index": {
    "dropdown": "1000",
    "sticky": "1020",
    "modal-overlay": "1040",
    "modal": "1050",
    "toast": "1080",
    "tooltip": "1090"
  },

  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "260ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },

  "format": {
    "date": "DD/MM/YYYY",
    "datetime": "HH:mm DD/MM/YYYY",
    "version-app": "{ten-app}_{YY}.{M}.{DD}{NN}_{arch}-setup.{ext} - xem docs/DESIGN_SYSTEM.md mục 6"
