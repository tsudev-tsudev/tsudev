    "font-mono": "'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace",
    "font-size": {
      "xs": "12px",
      "sm": "13px",
      "body-desktop": "14px",
      "body-desktop-lg": "15px",
      "body-web": "15px",
      "body-web-lg": "16px",
      "h4": "18px",
      "h3": "20px",
      "h2": "24px",
      "h1": "30px"
    },
    "line-height": {
      "heading": "1.3",
      "body": "1.55",
      "long": "1.6"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "letter-spacing": {
      "body": "0",
      "heading": "-0.01em",
      "caps-label": "0.04em"
    }
