{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsudev-tsudev/tsudev-standards/main/tokens/design-tokens.schema.json",
  "title": "tsudev design tokens",
  "description": "Lược đồ cho tokens/design-tokens.json - nguồn chân lý duy nhất của giao diện hệ sinh thái tsudev. IDE dùng file này để tự gợi ý và bắt lỗi khi sửa token.",
  "type": "object",
  "required": ["meta", "color", "typography", "radius", "spacing", "shadow", "z-index", "motion"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["name", "version", "updated"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "updated": {
          "type": "string",
          "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
          "description": "Ngày dạng DD/MM/YYYY theo DESIGN_SYSTEM.md mục 4"
        },
        "source": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      }
    },
    "color": {
      "type": "object",
      "required": ["light", "warm", "dark"],
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/$defs/palette" },
        "warm": { "$ref": "#/$defs/palette" },
        "dark": { "$ref": "#/$defs/palette" }
      }
    },
    "typography": {
      "type": "object",
      "required": ["font-family", "font-mono", "font-size", "line-height", "weight", "letter-spacing"],
      "properties": {
        "font-family": { "type": "string" },
        "font-mono": { "type": "string" },
        "font-size": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cssSize" } },
        "line-height": { "type": "object", "additionalProperties": { "type": "string" } },
        "weight": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[1-9]00$" } },
        "letter-spacing": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "radius": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cssSize" } },
    "spacing": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cssSize" } },
    "shadow": { "type": "object", "additionalProperties": { "type": "string" } },
    "z-index": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^\\d+$" } },
    "motion": { "type": "object", "additionalProperties": { "type": "string" } },
    "format": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$",
      "description": "Mã màu 6 chữ số, chữ HOA. Không dùng dạng rút gọn 3 chữ số."
    },
    "colorValue": {
      "oneOf": [
        { "$ref": "#/$defs/hexColor" },
        { "type": "string", "pattern": "^rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, (0|1|0?\\.\\d+)\\)$" }
      ]
    },
    "cssSize": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?(px|rem|em)$" },
    "palette": {
      "type": "object",
      "description": "Một chế độ nền. MỌI chế độ phải khai đủ cùng một bộ vai trò - thiếu một vai trò ở một chế độ là lỗi.",
      "additionalProperties": false,
      "required": [
        "bg-base", "bg-surface", "bg-subtle", "bg-hover",
        "border", "border-strong", "border-control",
        "text-primary", "text-secondary", "text-muted", "text-link",
        "primary", "primary-hover", "primary-active", "on-primary", "focus-ring",
        "success", "warning", "danger", "info", "on-status", "overlay"
      ],
      "properties": {
        "bg-base": { "$ref": "#/$defs/hexColor" },
        "bg-surface": { "$ref": "#/$defs/hexColor" },
        "bg-subtle": { "$ref": "#/$defs/hexColor" },
        "bg-hover": { "$ref": "#/$defs/hexColor" },
        "border": { "$ref": "#/$defs/hexColor" },
        "border-strong": { "$ref": "#/$defs/hexColor" },
        "border-control": { "$ref": "#/$defs/hexColor" },
        "text-primary": { "$ref": "#/$defs/hexColor" },
        "text-secondary": { "$ref": "#/$defs/hexColor" },
        "text-muted": { "$ref": "#/$defs/hexColor" },
        "text-link": { "$ref": "#/$defs/hexColor" },
        "primary": { "$ref": "#/$defs/hexColor" },
        "primary-hover": { "$ref": "#/$defs/hexColor" },
        "primary-active": { "$ref": "#/$defs/hexColor" },
        "on-primary": { "$ref": "#/$defs/hexColor" },
        "focus-ring": { "$ref": "#/$defs/hexColor" },
        "success": { "$ref": "#/$defs/hexColor" },
        "warning": { "$ref": "#/$defs/hexColor" },
        "danger": { "$ref": "#/$defs/hexColor" },
        "info": { "$ref": "#/$defs/hexColor" },
        "on-status": { "$ref": "#/$defs/hexColor" },
        "overlay": { "$ref": "#/$defs/colorValue" }
      }
    }
  }
}
