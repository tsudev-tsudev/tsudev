# ============================================================
# .env.example - MẪU biến môi trường. KHÔNG chứa giá trị thật.
# Copy thành .env (đã nằm trong .gitignore) rồi điền giá trị thật.
# Quy tắc đầy đủ: docs/SECURITY_BASELINE.md mục 3.
# ============================================================

# --- Danh tính project ---
APP_NAME=ten-project
APP_ENV=development          # development | staging | production
APP_URL=http://localhost:3000

# --- Đồng bộ bộ quy ước trung tâm ---
# Repo tsudev-standards là Public nên KHÔNG cần token để đồng bộ.
TSUDEV_STANDARDS_REF=main    # main | v2.0.0 | <commit-sha>

# --- Ví dụ các nhóm biến thường gặp. Xóa nhóm không dùng. ---
# DATABASE_URL=
# REDIS_URL=
# JWT_SECRET=                # sinh bằng: openssl rand -base64 48
# SESSION_SECRET=            # sinh bằng: openssl rand -base64 48
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SENTRY_DSN=

# CẢNH BÁO: mọi dòng ở đây PHẢI để trống giá trị hoặc dùng giá trị giả.
# Commit một giá trị thật vào file này = sự cố bảo mật, xử lý theo
# docs/SECURITY_BASELINE.md mục 9 (Quy trình ứng phó sự cố).
