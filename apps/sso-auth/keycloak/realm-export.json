{
  "realm": "tsudev-local",
  "enabled": true,
  "clients": [
    {
      "clientId": "tsudev-frontend",
      "name": "tsudev-frontend",
      "rootUrl": "http://tsudev.localhost:8080",
      "redirectUris": ["http://tsudev.localhost:8080/*", "http://frontend-main:3000/*"],
      "webOrigins": ["http://tsudev.localhost:8080", "http://frontend-main:3000"],
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "devuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "email": "dev@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "devpass",
          "temporary": false
        }
      ]
    }
  ]
}
