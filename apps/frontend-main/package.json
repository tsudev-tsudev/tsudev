{
  "name": "frontend-main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "preview": "node ../../scripts/deploy-frontend.js preview",
    "deploy": "node ../../scripts/deploy-frontend.js deploy",
    "upload": "node ../../scripts/deploy-frontend.js upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.2.2",
    "@tsudev/identity-token": "*",
    "dotenv": "^16.3.1",
    "next": "15.5.22",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.7",
    "wrangler": "^4.118.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ]
  }
}
