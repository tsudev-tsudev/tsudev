{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "tsudev",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Tên miền tuỳ chỉnh. `custom_domain: true` khiến wrangler tự tạo luôn bản ghi
  // DNS trong zone tsudev.com (zone phải nằm cùng tài khoản Cloudflare) — không
  // phải thêm tay. Cả hai host đều phục vụ; thẻ canonical do components/Seo.jsx
  // phát ra luôn trỏ về apex nên không có chuyện trùng lặp nội dung.
  "routes": [
    { "pattern": "tsudev.com", "custom_domain": true },
    { "pattern": "www.tsudev.com", "custom_domain": true }
  ],
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tsudev"
    }
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  // Biến LÚC CHẠY của Worker (khác NEXT_PUBLIC_*, thứ được nội suy lúc build —
  // xem apps/frontend-main/.env.production). Chỉ để giá trị KHÔNG bí mật ở đây;
  // secret đặt bằng `wrangler secret put`, đừng commit.
  //
  // Bốn biến *_SERVICE_URL cùng trỏ một chỗ vì bốn service backend đã gộp thành
  // một tiến trình trên Render (services/backend-bundle). Giữ bốn biến thay vì
  // gộp thành một: tách lại sau này không phải sửa mã.
  //
  // ⚠️ TỆP NÀY KHÔNG ĐƯỢC `npm run topology:gen` SINH RA và `topology:check`
  // KHÔNG đối chiếu nó. Thêm một service mới vào config/topology.json thì phải
  // thêm biến ở đây BẰNG TAY. Quên là biến rơi về giá trị dự phòng
  // `http://localhost:<port>` trong lib/services.ts — Worker gọi vào chính nó và
  // không bao giờ tới được service. Đã xảy ra thật với AUTH_SERVICE_URL ở lần
  // phát hành đầu của auth-service: đăng nhập hỏng hoàn toàn, mà `/api/auth/
  // providers` vẫn trả về đúng nên nhìn qua thì tưởng đã xong.
  //
  // ⚠️ Đối chiếu URL này với URL Render thật sự cấp cho service `tsudev-backend`
  // sau khi tạo — Render đổi tên nếu tên đã bị chiếm. Sai URL thì SSR nuốt lỗi
  // thành danh sách rỗng (lib/api.js) nên triệu chứng là TRANG TRỐNG, không
  // phải trang lỗi.
  "vars": {
    "CONTENT_SERVICE_URL": "https://tsudev-backend.onrender.com",
    "STORAGE_SERVICE_URL": "https://tsudev-backend.onrender.com",
    "TRUST_SERVICE_URL": "https://tsudev-backend.onrender.com",
    "AUTH_SERVICE_URL": "https://tsudev-backend.onrender.com",
    "NEXTAUTH_URL": "https://tsudev.com",
    "NEXTAUTH_COOKIE_DOMAIN": ".tsudev.com"
  }
}
