# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres
POSTGRES_USER=tsudev
POSTGRES_PASSWORD=tsudev
POSTGRES_DB=tsudev

# Redis
REDIS_PASSWORD=changeme

# --- Địa chỉ frontend ---
# tsudev chỉ còn MỘT app và MỘT origin, nên điều hướng trong site dùng href
# tương đối. Biến này chỉ phục vụ các chỗ BẮT BUỘC cần URL tuyệt đối: thẻ
# canonical, ảnh OG, mã nhúng huy hiệu tín nhiệm.
# Lên production đổi thành https://tsudev.com.
NEXT_PUBLIC_MAIN_URL=http://tsudev.localhost:8080

# NextAuth (dev)
# NEXTAUTH_URL phải khớp origin của CHÍNH app đang chạy, nếu không callback đăng
# nhập sẽ nhảy sang app kia. Giá trị dưới đây chỉ là mặc định cho frontend-main;
# scripts/write-env-local.js tự ghi đè đúng URL cho từng app khi chạy dev.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-secret
# Miền cookie phiên. Phải là miền cha của mọi host dev, nếu không đăng nhập
# không dính (xem CLAUDE.md).
NEXTAUTH_COOKIE_DOMAIN=.tsudev.localhost

# Database (Postgres). Local dev user-space cluster: port 5433
DATABASE_URL=postgresql://tsudev:tsudev@localhost:5433/tsudev?schema=public

# --- Trust Seal (Con dấu tín nhiệm) ---
# Khoá ký chứng chỉ, PEM PKCS#8 Ed25519 đã base64 hoá.
# Sinh bằng: node services/trust-service/scripts/genkey.js
# Để trống ở local -> service dùng khoá dev công khai và cảnh báo; production
# thiếu biến này thì service TỪ CHỐI khởi động.
TRUST_SIGNING_KEY=
TRUST_SIGNING_KEY_ID=
# Các khoá đã nghỉ, chỉ dùng để XÁC MINH, dạng "kid:<base64 PEM công khai>" ngăn
# nhau bằng dấu phẩy. Khi xoay khoá phải chuyển khoá cũ vào đây, nếu không mọi
# chứng chỉ đã cấp sẽ báo "không có khoá công khai" trên trang xác thực.
TRUST_SIGNING_KEYS_RETIRED=
# Dùng để dựng URL tuyệt đối trong chứng chỉ, mã nhúng và trang xác thực.
# Giá trị này được KÝ VÀO chứng chỉ - đổi sau khi đã cấp thì chứng chỉ cũ vẫn
# mang URL cũ. Đặt đúng domain thật TRƯỚC khi cấp chứng chỉ đầu tiên.
TRUST_ISSUER=http://localhost:3000
TRUST_SERVICE_URL=http://localhost:4003

# Giám sát tên miền định kỳ. Bộ hẹn giờ chạy trong tiến trình trust-service.
# Chạy nhiều bản service thì đặt TRUST_RECHECK_ENABLED=false và gọi
# POST /api/trust/admin/recheck từ một cron bên ngoài, nếu không mọi bản sẽ
# cùng kiểm một tập chứng chỉ.
TRUST_RECHECK_ENABLED=true
TRUST_RECHECK_INTERVAL_MIN=360     # chu kỳ chạy, phút
TRUST_RECHECK_STALE_MIN=1440       # chứng chỉ cũ hơn ngần này mới bị kiểm lại
TRUST_RECHECK_BATCH=25             # số chứng chỉ mỗi lượt
TRUST_RECHECK_GRACE_FAILURES=3     # số lần trượt LIÊN TIẾP trước khi tự đình chỉ
# Email giao dịch (auth-service). Để trống ở dev: không gửi thư thật, chỉ ghi
# cảnh báo ra log. Liên kết xác minh/đặt lại vẫn tạo được và đọc được từ log.
RESEND_API_KEY=
MAIL_FROM=tsudev <no-reply@tsudev.localhost>
# Khoá ký KHẲNG ĐỊNH DANH TÍNH mà BFF gửi xuống service (@tsudev/identity-token).
# Tối thiểu 32 ký tự. Thiếu ⇒ service trả 503 chứ không im lặng cho qua.
# Ở production PHẢI là giá trị ngẫu nhiên riêng, đặt qua secret manager.
INTERNAL_IDENTITY_SECRET=dev-only-identity-secret-khong-dung-o-production-0123456789
# Đăng nhập bằng bên thứ ba (tuỳ chọn ở dev). Để trống ⇒ provider không xuất
# hiện trên /login, thay vì hiện một nút bấm không đăng nhập được.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khoá mã hoá bí mật TOTP khi lưu vào DB. Tối thiểu 32 ký tự.
# Bí mật TOTP KHÔNG băm được (kiểm mã cần chính giá trị đó) nên nó phải được mã
# hoá, với khoá nằm NGOÀI DB - một bản sao DB bị rò mà không kèm khoá này thì
# không sinh được mã của ai cả. Đổi khoá làm mọi thiết bị 2FA đang dùng hỏng.
TOTP_ENCRYPTION_KEY=dev-only-totp-encryption-key-khong-dung-o-production-0123456789
# ── Toà soạn Agent AI (Newsroom) ─────────────────────────────────────────────
# Kế hoạch: docs/refactor-newsroom-agents.md
#
# Công tắc tổng. Để `false` cho tới khi đã nghiệm thu đường ống - bật lên là
# agent bắt đầu quét nguồn và viết bài thật.
NEWSROOM_ENABLED=false
# Gác /api/newsroom/tick. Worker cron gửi bằng header x-newsroom-token.
# Không đặt = endpoint trả 503 (cố ý ồn ào, không âm thầm mở).
NEWSROOM_TICK_TOKEN=
# Trần Neuron/ngày. Hạn mức miễn phí của Workers AI là 10.000, reset 00:00 UTC;
# 8000 chừa biên 20% cho vòng sửa lại.
NEWSROOM_DAILY_NEURON_BUDGET=8000
# Trần số vòng Writer<->Editor cho một bài. Không trần = đốt hạn mức im lặng.
NEWSROOM_MAX_REVISIONS=2
# Cloudflare Workers AI - nhà cung cấp CHÍNH. Token cần phạm vi "Workers AI".
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# Gemini - nhà cung cấp DỰ PHÒNG, chỉ dùng khi Workers AI cạn Neuron.
# Bỏ trống cũng chạy được: cạn hạn mức thì toà soạn dừng và ghi event.
GEMINI_API_KEY=

# >>> topology: sinh tự động, đừng sửa tay >>>
CONTENT_SERVICE_URL=http://localhost:4001
STORAGE_SERVICE_URL=http://localhost:4002
AUTH_SERVICE_URL=http://localhost:4004
NEWSROOM_SERVICE_URL=http://localhost:4005
CORS_ALLOWED_ORIGINS=http://tsudev.localhost:8080
S3_PUBLIC_ENDPOINT=http://cdn.tsudev.localhost:8080
BIND_HOST=127.0.0.1
# <<< topology <<<
