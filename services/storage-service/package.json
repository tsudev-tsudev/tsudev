{
  "name": "storage-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -L --watch src --ext ts,json --exec 'tsc -b ../.. && node dist/index.js'",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "NODE_ENV=test jest --runInBand",
    "pretest": "tsc -b ../.."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@tsudev/db": "*",
    "@tsudev/types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jose": "^4.15.9",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "jest": "^29.6.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
