# ---------------------------------------------------------------------------
# tsudev — production environment (mẫu). Sao chép thành .env và điền giá trị
# thật qua secret manager / Cloudflare Zero Trust. KHÔNG commit giá trị thật.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/tsudev?schema=public

# Redis (session / cache / rate-limit)
REDIS_URL=redis://:PASSWORD@redis-host:6379

# Keycloak (OIDC IdP)
KEYCLOAK_ISSUER=https://auth.tsudev.vn/realms/tsudev
KEYCLOAK_CLIENT_ID=tsudev-frontend
KEYCLOAK_CLIENT_SECRET=__set_me__
REQUIRE_ROLE_ENFORCEMENT=true
# Production KHÔNG bật các cờ dev sau:
# AUTH_DEV_BYPASS / E2E_BYPASS_KEYCLOAK

# NextAuth (đặt riêng cho từng app)
NEXTAUTH_SECRET=__long_random_secret__
NEXTAUTH_URL=https://tsudev.vn
NEXTAUTH_COOKIE_DOMAIN=.tsudev.vn

# Object storage (Cloudflare R2 / S3) + CDN
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://cdn.tsudev.vn
S3_BUCKET=tsudev
S3_ACCESS_KEY=__set_me__
S3_SECRET_KEY=__set_me__
NEXT_PUBLIC_STORAGE_URL=https://tsudev.vn

# Service discovery (nội bộ)
USER_SERVICE_URL=http://user-service:4000
CONTENT_SERVICE_URL=http://content-service:4001
STORAGE_SERVICE_URL=http://storage-service:4002

# Observability & alerting (§4)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=nguyentrangtinhsu@gmail.com
ALERT_EMAIL_WEBHOOK=
