# ---------------------------------------------------------------------------
# tsudev - production environment (mẫu). Sao chép thành .env và điền giá trị
# thật qua secret manager / Cloudflare Zero Trust. KHÔNG commit giá trị thật.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/tsudev?schema=public

# Xác thực do codebase tự quản lý: mật khẩu Argon2id trong DB, kiểm bởi
# auth-service (xem docs/auth.md). KHÔNG có nhà cung cấp danh tính ngoài nào:
# không có biến issuer/client-id/client-secret nào cần đặt.
#
# Phân quyền đọc `User.role` từ DB qua @tsudev/auth, fail closed - không có biến
# môi trường nào bật/tắt được. REQUIRE_ROLE_ENFORCEMENT, CONTENT_READ_ROLE,
# STORAGE_PRESIGN_ROLE, STORAGE_UPLOAD_ROLE đã bị gỡ khỏi mã nguồn; đặt lại
# không có tác dụng gì. Tương tự với mọi cờ bỏ qua xác thực thời dev
# (AUTH_DEV_BYPASS và bạn bè của nó): đã gỡ, đừng dựng lại.

# Khoá ký khẳng định danh tính BFF → service (@tsudev/identity-token).
# Tối thiểu 32 ký tự, ngẫu nhiên. PHẢI GIỐNG NHAU ở frontend (Cloudflare) và
# backend (Render): lệch nhau ⇒ mọi đường ghi đã xác thực trả 401.
INTERNAL_IDENTITY_SECRET=__long_random_secret__

# Đăng nhập bằng bên thứ ba. Thiếu biến ⇒ provider tương ứng KHÔNG được thêm
# vào (thay vì thêm một nút bấm không làm gì cả).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Khoá mã hoá bí mật TOTP khi lưu (auth-service). Tối thiểu 32 ký tự, ngẫu nhiên.
# ĐỔI KHOÁ NÀY = MỌI THIẾT BỊ 2FA ĐANG DÙNG HỎNG, và người dùng phải đăng nhập
# bằng mã dự phòng rồi thiết lập lại. Sao lưu nó cùng chỗ với TRUST_SIGNING_KEY.
TOTP_ENCRYPTION_KEY=__long_random_secret__

# NextAuth (đặt riêng cho từng app)
NEXTAUTH_SECRET=__long_random_secret__
NEXTAUTH_URL=https://tsudev.com
NEXTAUTH_COOKIE_DOMAIN=.tsudev.com

# Email giao dịch (xác minh địa chỉ, đặt lại mật khẩu) - auth-service
#
# Resend chứ không phải SMTP: apps/frontend-main chạy trên Cloudflare Workers,
# nơi không mở được socket TCP tuỳ ý. Không đặt khoá = không gửi thư, và luồng
# quên mật khẩu im lặng không hoạt động (có cảnh báo ở log, không có lỗi cho
# người dùng - phản hồi luôn giống nhau để không dò được tài khoản).
RESEND_API_KEY=__set_me__
MAIL_FROM=tsudev <no-reply@tsudev.com>

# Object storage (Cloudflare R2 / S3)
#
# HAI biến này TRÙNG NHAU khi dùng R2, và đó là đúng - khác với dev.
# S3_PUBLIC_ENDPOINT chỉ phục vụ MỘT việc: làm endpoint để KÝ URL presign
# (`s3Signer` trong storage-service). Nên nó phải là host nói được giao thức
# chữ ký S3 VÀ trình duyệt với tới được. Endpoint S3 API của R2 thoả cả hai.
#
# ĐỪNG đặt thành cdn.tsudev.com. Tên miền tuỳ chỉnh của R2 phục vụ object qua
# CDN chứ KHÔNG cài đặt giao thức chữ ký S3 - URL presign ký cho host đó sẽ bị
# từ chối. Tệ hơn: gắn tên miền tuỳ chỉnh làm bucket thành CÔNG KHAI, nghĩa là
# mọi file riêng tư đọc được nếu biết khoá.
#
# Ở dev thì hai biến KHÁC nhau, vì S3_ENDPOINT trỏ `minio:9000` trong mạng
# docker còn trình duyệt không với tới được host đó.
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=tsudev
S3_ACCESS_KEY=__set_me__
S3_SECRET_KEY=__set_me__

# Service discovery (nội bộ)
CONTENT_SERVICE_URL=http://content-service:4001
STORAGE_SERVICE_URL=http://storage-service:4002

# Observability & alerting (§4)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=devnguyentrangtinhsu@gmail.com
ALERT_EMAIL_WEBHOOK=

# ── Toà soạn Agent AI (Newsroom) ─────────────────────────────────────────────
# Kế hoạch: docs/refactor-newsroom-agents.md
#
# Công tắc tổng. Để `false` cho tới khi đã nghiệm thu đường ống - bật lên là
# agent bắt đầu quét nguồn và viết bài thật.
NEWSROOM_ENABLED=false
# Gác /api/newsroom/tick. Worker cron gửi bằng header x-newsroom-token.
# Không đặt = endpoint trả 503 (cố ý ồn ào, không âm thầm mở).
NEWSROOM_TICK_TOKEN=
# Trần Neuron/ngày. Hạn mức miễn phí của Workers AI là 10.000, reset 00:00 UTC;
# 8000 chừa biên 20% cho vòng sửa lại.
NEWSROOM_DAILY_NEURON_BUDGET=8000
# Trần số vòng Writer<->Editor cho một bài. Không trần = đốt hạn mức im lặng.
NEWSROOM_MAX_REVISIONS=2
# Cloudflare Workers AI - nhà cung cấp CHÍNH. Token cần phạm vi "Workers AI".
CF_ACCOUNT_ID=
CF_AI_TOKEN=
# Gemini - nhà cung cấp DỰ PHÒNG, chỉ dùng khi Workers AI cạn Neuron.
# Bỏ trống cũng chạy được: cạn hạn mức thì toà soạn dừng và ghi event.
GEMINI_API_KEY=
